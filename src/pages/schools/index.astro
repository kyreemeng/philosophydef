---
import BaseLayout from "../../layouts/BaseLayout.astro";

const schools = [
  {
    href: "/schools/stoicism",
    name: "Stoicism",
    blurb: "Virtue, nature, and the discipline of judgment.",
    thinkers: "Seneca · Epictetus · Marcus",
  },
  {
    href: "/schools/existentialism",
    name: "Existentialism",
    blurb: "Freedom, responsibility, absurdity, and authentic choice.",
    thinkers: "Sartre · Beauvoir · Camus",
  },
  {
    href: "/schools/confucianism",
    name: "Confucianism",
    blurb: "Humaneness, ritual, learning, and cultivated roles.",
    thinkers: "Confucius · Mencius · Xunzi",
  },
  {
    href: "/schools/daoism",
    name: "Daoism",
    blurb: "The Dao, wuwei, and naturalness without forced order.",
    thinkers: "Laozi · Zhuangzi",
  },
  {
    href: "/schools/rationalism",
    name: "Rationalism",
    blurb: "Reason, a priori insight, and systematic metaphysics.",
    thinkers: "Descartes · Spinoza · Leibniz",
  },
  {
    href: "/schools/empiricism",
    name: "Empiricism",
    blurb: "Experience as the primary source of ideas and evidence.",
    thinkers: "Locke · Berkeley · Hume",
  },
  {
    href: "/schools/pragmatism",
    name: "Pragmatism",
    blurb: "Meaning, truth, and inquiry tied to practical consequences.",
    thinkers: "Peirce · James · Dewey",
  },
  {
    href: "/schools/africana-philosophy",
    name: "Africana Philosophy",
    blurb: "Critique, conceptual decolonization, and diaspora thought.",
    thinkers: "Wiredu · Hountondji · Fanon · Appiah",
  },
  {
    href: "/schools/islamic-philosophy",
    name: "Islamic Philosophy",
    blurb: "Falsafa: intellect, prophecy, and demonstrative science.",
    thinkers: "Avicenna · Averroes · al-Farabi",
  },
  {
    href: "/schools/analytic-philosophy",
    name: "Analytic Philosophy",
    blurb: "Clarity, logic, language, intention, and mind.",
    thinkers: "Wittgenstein · Anscombe · Foot",
  },
  {
    href: "/schools/neo-confucianism",
    name: "Neo-Confucianism",
    blurb: "Principle, heart-mind, and the unity of knowledge and action.",
    thinkers: "Zhu Xi · Wang Yangming",
  },
  {
    href: "/schools/platonism",
    name: "Platonism",
    blurb: "Forms, the Good, and dialectic as education of desire.",
    thinkers: "Plato · later Platonic lineages",
  },
  {
    href: "/schools/kyoto-school",
    name: "Kyoto School",
    blurb: "Absolute nothingness, experience, and religious worldview.",
    thinkers: "Nishida · Nishitani",
  },
  {
    href: "/schools/german-idealism",
    name: "German Idealism",
    blurb: "Freedom, spirit, and systematic post-Kantian reason.",
    thinkers: "Hegel · related idealists",
  },
  {
    href: "/schools/jewish-rationalism",
    name: "Jewish Rationalism",
    blurb: "Reason, revelation, law, and negative theology.",
    thinkers: "Maimonides · Saadia Gaon",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Philosophy Schools",
  description:
    "Browse philosophy by school: Stoicism, Existentialism, Confucianism, Daoism, Africana, Islamic, Analytic, Kyoto School, and more.",
  numberOfItems: schools.length,
};
---

<BaseLayout
  title="Philosophy Schools | Stoicism, Africana, Islamic, Analytic & More"
  description="Explore philosophy schools with verified English quotes—Stoicism, Existentialism, Confucianism, Daoism, Africana Philosophy, Islamic Philosophy, Analytic Philosophy, Kyoto School, and more."
  canonical="/schools"
  schema={schema}
>
  <div class="page-shell">
    <header class="page-intro">
      <h1>Philosophy schools</h1>
      <p>Enter through a tradition, then follow thinkers and themes.</p>
    </header>
    <div class="theme-directory">
      {
        schools.map((school) => (
          <article class="directory-row">
            <div>
              <h2>
                <a href={school.href}>{school.name}</a>
              </h2>
              <p>{school.blurb}</p>
            </div>
            <p>{school.thinkers}</p>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
