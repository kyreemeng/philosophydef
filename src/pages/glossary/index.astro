---
/**
 * The glossary index.
 *
 * Terms are listed by the language they belong to and in the order the glossary
 * defines them, which follows the traditions rather than the alphabet. Someone
 * arriving from a Chinese passage should find the Chinese terms together, not
 * scattered between *ataraxia* and *telos*.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { concepts, conceptPath, conceptSlug } from "../../data/concept-glossary";

const site = (Astro.site ?? new URL("https://www.philosophydef.com"))
  .toString()
  .replace(/\/$/, "");

const groups: { language: string; entries: typeof concepts }[] = [];
for (const concept of concepts) {
  const existing = groups.find((group) => group.language === concept.language);
  if (existing) existing.entries.push(concept);
  else groups.push({ language: concept.language, entries: [concept] });
}

const withMisreading = concepts.filter((concept) => concept.misreading).length;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    name: "Philosophy Defined glossary",
    url: `${site}/glossary`,
    description:
      "Technical terms used in the archive's quotations, with the readings the sources do not support.",
    hasDefinedTerm: concepts.map((concept) => ({
      "@type": "DefinedTerm",
      name: concept.term,
      ...(concept.original ? { alternateName: concept.original } : {}),
      url: `${site}/glossary/${conceptSlug(concept)}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: "Glossary" },
    ],
  },
];
---

<BaseLayout
  title="Glossary of philosophical terms | Philosophy Defined"
  description="A working glossary of the technical terms in the archive's quotations — aretē, wu wei, śūnyatā, ressentiment — with the readings the sources do not support."
  canonical="/glossary"
  schema={schema}
>
  <div class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">Glossary</p>
      <h1>Glossary of philosophical terms</h1>
      <p>
        {concepts.length} terms that the archive's quotations use in a technical
        sense, in the language they came from.
      </p>
    </header>

    <div class="prose-layout">
      <aside class="prose-aside">
        <p>
          {withMisreading} of the {concepts.length} entries carry a specific
          misreading: a translation that hardened into a false equivalence and
          now circulates as though it were the text.
        </p>
        <p>
          The archive's quotations are English renderings of Greek, Chinese,
          Sanskrit, Arabic, Hebrew, German, and French. Transliteration alone
          cannot carry that, so each entry names the original alongside the gloss.
        </p>
      </aside>

      <article class="prose">
        <h2>How to use this glossary</h2>
        <p>
          Reach for an entry when a quotation uses a word you suspect is doing
          more work than its English equivalent admits. Each page gives what the
          term does in the argument it belongs to, what it is commonly mistranslated
          as, and where in the archive it is in play. The terms are not a
          dictionary: they are the words a reader of this corpus actually trips
          over.
        </p>

        {groups.map((group) => (
          <section>
            <h2>{group.language}</h2>
            <ul class="link-list">
              {group.entries.map((entry) => (
                <li>
                  <a href={conceptPath(entry)}>
                    {entry.term}
                    {entry.original && (
                      <span lang={entry.languageTag ?? "und"}>
                        {" "}
                        {entry.original}
                      </span>
                    )}
                  </a>
                  {" — "}
                  {entry.gloss}
                </li>
              ))}
            </ul>
          </section>
        ))}

        <section class="related-block">
          <h2>Related</h2>
          <ul class="link-list">
            <li>
              <a href="/sourcing-method">Sourcing method</a> — how a passage and
              its wording are established.
            </li>
            <li>
              <a href="/editorial-policy">Editorial policy</a> — what is selected
              and what is excluded.
            </li>
            <li>
              <a href="/quotes">The quotation archive</a> — the passages these
              terms occur in.
            </li>
          </ul>
        </section>
      </article>
    </div>
  </div>
</BaseLayout>
