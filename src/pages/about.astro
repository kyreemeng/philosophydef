---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactEmail, corpusStatus, editor } from "../data/editorial";
import { organizationSchema } from "../lib/site-schema";
import {
  VERIFICATION_LEVELS,
  VERIFICATION_LEVEL_ORDER,
} from "../lib/verification";

const status = corpusStatus();
const format = (value: number) => value.toLocaleString("en-US");

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "About Philosophy Blind Box",
    description:
      "What Philosophy Blind Box is, how its quotation records are built and checked, and how much of the archive has been verified.",
    url: new URL("/about", Astro.site),
    mainEntity: { "@type": "Organization", name: "Philosophy Blind Box", url: Astro.site },
  },
  organizationSchema(Astro.site),
];
---

<BaseLayout
  title="About Philosophy Blind Box | How the Archive Is Checked"
  description={`An archive of ${format(status.total)} philosophy quotations traced to their sources. ${format(status.checked)} checked against a cited edition, with original wording and misattributions recorded.`}
  canonical="/about"
  schema={schema}
>
  <div class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">About</p>
      <h1>Philosophy quotations, traced to where they were written</h1>
      <p>
        Philosophy Blind Box records where a quotation comes from — the work, the
        passage, the original language — and says plainly how much of that has
        been checked.
      </p>
    </header>

    <div class="prose-layout">
      <aside class="prose-aside">
        <p>
          {format(status.total)} passages from {format(status.thinkers)} thinkers
          and texts, across Greco-Roman, Chinese, Indian, Islamic, Jewish,
          Japanese, and Africana traditions.
        </p>
      </aside>
      <article class="prose">
        <h2>What the archive is for</h2>
        <p>
          Philosophy quotations circulate detached from their sources, and many
          of the most shared ones were never written by the person they are
          credited to. This archive exists to answer the question a careful
          reader asks next: where exactly does this come from, and does the
          English say what the original says?
        </p>

        <h2 id="verification-levels">How much has been checked</h2>
        <p>
          Every quotation page states which of the four levels below it has
          reached. The levels are one vocabulary used across the whole archive —
          the homepage, the editorial policy, and each passage's own status line
          all read them from the same register — so a page never claims a check
          it has not performed.
        </p>
        <ul>
          {
            VERIFICATION_LEVEL_ORDER.map((level) => (
              <li>
                <strong>
                  {VERIFICATION_LEVELS[level].label} — {format(status.levels[level])}{" "}
                  {status.levels[level] === 1 ? "passage" : "passages"}.
                </strong>{" "}
                {VERIFICATION_LEVELS[level].description}
              </li>
            ))
          }
        </ul>

        <h2>How a record is built</h2>
        <p>
          Each passage is filed with its thinker, work, locator, school, and
          themes. Locators use the reference system scholars use for that
          author — Stephanus numbers for Plato, Bekker numbers for Aristotle,
          book and passage for the Analects, section numbers for Nietzsche — so a
          reader can find the passage in any edition. The details are in the
          <a href="/sourcing-method">sourcing method</a>; selection and
          correction rules are in the <a href="/editorial-policy">editorial policy</a>.
        </p>

        <h2>Where to start</h2>
        <p>
          If you are holding a quotation and want to know who said it, use
          <a href="/quote-source">the quote source finder</a>. To read by
          person, begin with <a href="/thinkers/socrates">Socrates</a> or
          <a href="/thinkers/friedrich-nietzsche">Nietzsche</a>; by subject, with
          <a href="/themes/self">the self</a> or
          <a href="/quotes/about/love">love</a>; by work, with
          <a href="/works/meditations">the Meditations</a> or the
          <a href="/works">index of works</a>. For background, the
          <a href="/what-is-philosophy">guides</a> and the
          <a href="/glossary">glossary of terms</a> explain the vocabulary.
        </p>

        {
          editor && (
            <>
              <h2>Editor</h2>
              <p>
                <strong>{editor.name}</strong>. {editor.bio}
              </p>
            </>
          )
        }

        <h2>Corrections</h2>
        <p>
          Attributions and locators are corrected when they are found to be
          wrong, and each correction is listed with its date in the
          <a href="/editorial-policy#corrections-log">corrections log</a>.
          {contactEmail && (
            <>
              {" "}To report an error, write to{" "}
              <a href={`mailto:${contactEmail}`}>{contactEmail}</a> with the page
              address and the edition you are checking against.
            </>
          )}
        </p>

        <h2>Why “blind box”?</h2>
        <p>
          The site began as a random quotation generator: one passage at a time,
          chosen by chance, so that reading starts before selection. The
          <a href="/random-philosophy-generator">random generator</a> is still
          here. The archive behind it is the part that has grown.
        </p>
      </article>
    </div>
  </div>
</BaseLayout>
