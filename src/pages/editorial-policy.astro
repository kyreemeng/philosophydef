---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactEmail, corpusStatus, corrections } from "../data/editorial";
import {
  VERIFICATION_LEVELS,
  VERIFICATION_LEVEL_ORDER,
} from "../lib/verification";

const status = corpusStatus();

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Editorial Policy",
  description:
    "How Philosophy Defined selects, verifies, and presents English philosophy quotations.",
};
---

<BaseLayout
  title="Editorial Policy | Philosophy Defined"
  description="Our editorial policy for selecting, verifying, translating standards, and correcting English philosophy quotations."
  canonical="/editorial-policy"
  schema={schema}
>
  <div class="page-shell">
    <header class="page-intro">
      <h1>Editorial policy</h1>
      <p>
        Philosophy Defined is a curated archive. Selection, wording, and attribution
        are editorial judgments accountable to evidence.
      </p>
    </header>

    <div class="prose-layout">
      <aside class="prose-aside">
        <p>
          Last updated: 30 September 2026. The archive holds {status.total}
          passages: {status.originalChecked} with the original wording recorded,
          {" "}{status.editionChecked} edition-checked only, {status.annotated}{" "}
          annotated, {status.recorded} recorded only.
        </p>
      </aside>
      <article class="prose">
        <h2>Purpose</h2>
        <p>
          The archive presents sourced English philosophy quotations for reading,
          teaching, and reflection. It is not a substitute for primary texts, scholarly
          editions, or peer-reviewed commentary.
        </p>

        <h2>Coverage</h2>
        <p>
          The curated set spans {status.total} passages drawn from Greco-Roman,
          Chinese, Indian, Islamic, Jewish, Japanese, and Africana traditions, with
          expanded representation of women philosophers. Coverage aims at balanced
          depth rather than an exhaustive canon.
        </p>

        <h2>Selection criteria</h2>
        <p>
          Passages are included when they are attributable with reasonable confidence,
          philosophically substantive, and clear in English. We exclude political slogans
          without philosophical content, viral misattributions, and opaque jargon that
          cannot be responsibly rendered.
        </p>

        <h2>Attribution standard</h2>
        <p>
          Each entry records thinker, school, source, and theme. Where scholarly debate
          exists about authorship or wording, we prefer the most widely recognized
          attribution and note uncertainty in source fields when needed. Famous lines
          are not kept merely because they are famous if the attribution is known to be
          false.
        </p>

        <h2>Verification levels</h2>
        <p>
          Every quotation page states its level, and the levels mean the same thing
          everywhere on the site — the homepage, the About page, and each passage's
          status line read one shared register:
        </p>
        <ul>
          {
            VERIFICATION_LEVEL_ORDER.map((level) => (
              <li>
                <strong>{VERIFICATION_LEVELS[level].label}.</strong>{" "}
                {VERIFICATION_LEVELS[level].description}
              </li>
            ))
          }
        </ul>
        <p>
          Recorded pages carry the corpus wording and source but nothing checked, so
          they say so and are marked noindex until they carry writing of their own.
          “Verified” without a level attached is not used anywhere on the site.
        </p>

        <h2>English renderings</h2>
        <p>
          Primary display language is English. Renderings are checked against reliable
          published translations and reference works. We do not invent classical-language
          wording for display. Where multiple reputable English versions exist, we choose
          clarity for general readers while preserving philosophical sense.
        </p>

        <h2>Corrections</h2>
        <p>
          If an attribution, theme label, or wording is wrong, we correct it and retain
          the entry when the passage remains suitable. Removed entries are those that
          fail the selection criteria after review. Duplicate entries for the same
          passage are merged, and the old address redirects to the surviving page.
          {contactEmail && (
            <>
              {" "}Report an error to <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
            </>
          )}
        </p>

        <h3 id="corrections-log">Corrections log</h3>
        <ul>
          {corrections.map((entry) => (
            <li>
              <time datetime={entry.date}>{entry.date}</time> ·{" "}
              <a href={entry.page}>{entry.page}</a> — {entry.change}
            </li>
          ))}
        </ul>

        <h2>Independence</h2>
        <p>
          Editorial decisions are not sold. Affiliate or advertising relationships, if
          introduced later, will be disclosed and will not determine which quotations
          appear in the archive.
        </p>

        <h2>Related</h2>
        <p>
          See also our <a href="/sourcing-method">sourcing method</a> and
          <a href="/about#verification-levels">about</a> page.
        </p>
      </article>
    </div>
  </div>
</BaseLayout>
