---
import BaseLayout from "../../layouts/BaseLayout.astro";
import quotes from "../../data/quotes.json";
import {
  adjacentQuotes,
  canonicalizeTheme,
  citationFormats,
  quoteDescription,
  quoteTitle,
  relatedByAuthor,
  relatedByTheme,
  slugify,
  themeSlug,
  truncateWords,
} from "../../lib/content";
import { guides } from "../../data/guides";
import { shouldIndexThinkerThemePair } from "../../lib/indexing";

export function getStaticPaths() {
  return quotes.map((quote) => ({
    params: { id: quote.id.toLowerCase() },
    props: { quote },
  }));
}

const { quote } = Astro.props;
const quoteUrl = `/quotes/${quote.id.toLowerCase()}`;
const description = quoteDescription(quote);
const title = quoteTitle(quote);
const primaryTheme = canonicalizeTheme(quote.themes[0] ?? "Philosophy");
const sameAuthor = relatedByAuthor(quote, 5);
const sameTheme = relatedByTheme(quote, 5);
const { prev, next } = adjacentQuotes(quote);
const citations = citationFormats(quote);
const relatedGuides = guides
  .filter(
    (guide) =>
      guide.thinkers.includes(quote.author) ||
      guide.slug.includes(themeSlug(primaryTheme)) ||
      guide.title.toLowerCase().includes(primaryTheme.toLowerCase()),
  )
  .slice(0, 3);
const thinkerThemeQuotes = quotes.filter(
  (item) =>
    item.author === quote.author &&
    item.themes.some((theme) => canonicalizeTheme(theme) === primaryTheme),
);
const hasIndexableThinkerThemePage = shouldIndexThinkerThemePair({
  author: quote.author,
  theme: primaryTheme,
  quotes: thinkerThemeQuotes,
});

const context =
  quote.source && quote.source !== "Tradition"
    ? `Archive record: this English passage is associated with ${quote.source}, within the ${quote.school} tradition. Use the cited work or edition when a scholarly attribution is needed.`
    : `Archive record: this English passage is filed under the ${quote.school} tradition. The page preserves the available attribution and identifies the tradition where a single work is not recorded.`;

const commentary = `Read in the register of ${primaryTheme.toLowerCase()}, the sentence asks the reader to test an assumption rather than to collect a slogan. In ${quote.author}'s wider work, similar claims are usually offered as prompts for judgment: what would have to be true for the sentence to hold, and what would follow if it did?`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quotation",
    text: quote.text,
    inLanguage: "en",
    creator: {
      "@type": "Person",
      name: quote.author,
    },
    about: primaryTheme,
    isPartOf: {
      "@type": "Collection",
      name: "Philosophy Blind Box",
      url: Astro.site,
    },
    url: new URL(quoteUrl, Astro.site),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Quotes",
        item: new URL("/quotes", Astro.site),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: quote.author,
        item: new URL(`/thinkers/${slugify(quote.author)}`, Astro.site),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: quote.id,
        item: new URL(quoteUrl, Astro.site),
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={quoteUrl}
  image={`/og/quotes/${quote.id.toLowerCase()}.png`}
  type="article"
  schema={schema}
>
  <article class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">{quote.id}</p>
      <h1>“{truncateWords(quote.text, 12)}” — {quote.author} ({quote.id})</h1>
      <p>
        An English quotation associated with {quote.source || quote.school},
        organized here under {primaryTheme.toLowerCase()}.
      </p>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/quotes">Quotes</a>
        <span aria-hidden="true">/</span>
        <a href={`/thinkers/${slugify(quote.author)}`}>{quote.author}</a>
        <span aria-hidden="true">/</span>
        <span>{quote.id}</span>
      </nav>
    </header>

    <section class="quote-stage" aria-labelledby="quotation">
      <div class="quote-panel">
        <p class="quote-index">English</p>
        <div>
          <blockquote class="quote-text" id="quotation">
            {quote.text}
          </blockquote>
          <div class="quote-meta">
            <div class="meta-item">
              <span>Thinker</span>
              <strong>
                <a href={`/thinkers/${slugify(quote.author)}`}>{quote.author}</a>
              </strong>
            </div>
            <div class="meta-item">
              <span>School</span>
              <strong>{quote.school}</strong>
            </div>
            <div class="meta-item">
              <span>Source</span>
              <strong>{quote.source || "Tradition"}</strong>
            </div>
            <div class="meta-item">
              <span>Theme</span>
              <strong>
                <a href={`/themes/${themeSlug(primaryTheme)}`}>{primaryTheme}</a>
              </strong>
            </div>
          </div>
          <div class="quote-tools">
            <a class="button" href="/#featured-quote">Another quotation</a>
            <a class="button secondary" href={`/quotes?q=${encodeURIComponent(quote.author)}`}>
              More from this thinker
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="quote-depth prose-layout">
      <aside class="prose-aside">
        <p>
          Context and commentary are editorial aids for reading. They do not replace
          the primary text or scholarly commentary.
        </p>
      </aside>
      <div class="prose">
        <h2>Source context</h2>
        <p>{context}</p>
        <h2>A short reading</h2>
        <p>{commentary}</p>
        <h2>How to cite this quotation</h2>
        <p><strong>APA:</strong> {citations.apa}</p>
        <p><strong>MLA:</strong> {citations.mla}</p>
        <p><strong>Chicago:</strong> {citations.chicago}</p>
      </div>
    </section>

    {
      hasIndexableThinkerThemePage && (
        <p class="related-link">
          <a href={`/thinkers/${slugify(quote.author)}/${themeSlug(primaryTheme)}`}>
            Explore {quote.author} on {primaryTheme.toLowerCase()}
          </a>
        </p>
      )
    }

    {
      sameAuthor.length > 0 && (
        <section class="related-block" aria-labelledby="same-author-title">
          <div class="section-intro">
            <p class="section-label">Same thinker</p>
            <h2 id="same-author-title">More from {quote.author}</h2>
          </div>
          <ol class="quote-list compact-list">
            {sameAuthor.map((item) => (
              <li class="quote-list-item">
                <blockquote>{item.text}</blockquote>
                <footer>
                  <a href={`/quotes/${item.id.toLowerCase()}`}>{item.id}</a>
                  <br />
                  {canonicalizeTheme(item.themes[0] ?? "Philosophy")}
                </footer>
              </li>
            ))}
          </ol>
          <p class="related-link">
            <a href={`/thinkers/${slugify(quote.author)}`}>
              All quotations by {quote.author}
            </a>
          </p>
        </section>
      )
    }

    {
      sameTheme.length > 0 && (
        <section class="related-block" aria-labelledby="same-theme-title">
          <div class="section-intro">
            <p class="section-label">Same theme</p>
            <h2 id="same-theme-title">More on {primaryTheme.toLowerCase()}</h2>
          </div>
          <ol class="quote-list compact-list">
            {sameTheme.map((item) => (
              <li class="quote-list-item">
                <blockquote>{item.text}</blockquote>
                <footer>
                  <a href={`/quotes/${item.id.toLowerCase()}`}>{item.author}</a>
                  <br />
                  {item.school}
                </footer>
              </li>
            ))}
          </ol>
          <p class="related-link">
            <a href={`/themes/${themeSlug(primaryTheme)}`}>
              Browse the {primaryTheme.toLowerCase()} theme
            </a>
          </p>
        </section>
      )
    }

    {
      relatedGuides.length > 0 && (
        <nav class="guide-related" aria-label="Related guides">
          <p class="eyebrow">Related guides</p>
          <ul>
            {relatedGuides.map((guide) => (
              <li>
                <a href={`/${guide.slug}`}>{guide.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <nav class="quote-pager" aria-label="Adjacent quotations">
      <a href={`/quotes/${prev.id.toLowerCase()}`}>← Previous: {prev.author}</a>
      <a href={`/quotes/${next.id.toLowerCase()}`}>Next: {next.author} →</a>
    </nav>
  </article>
</BaseLayout>
