---
import BaseLayout from "../../layouts/BaseLayout.astro";
import quotes from "../../data/quotes.json";
import {
  adjacentQuotes,
  canonicalizeTheme,
  citationFormats,
  quoteDescription,
  quoteHeading,
  quoteTitle,
  relatedByAuthor,
  relatedByTheme,
  slugify,
  themeGroups,
  themePath,
  themeSlug,
} from "../../lib/content";
import { guides } from "../../data/guides";
import {
  isTextTradition,
  themeGuideFor,
  thinkerGuideFor,
} from "../../data/enrichment";
import {
  shouldIndexTheme,
  shouldIndexThinkerThemePair,
} from "../../lib/indexing";

export function getStaticPaths() {
  return quotes.map((quote) => ({
    params: { id: quote.id.toLowerCase() },
    props: { quote },
  }));
}

const { quote } = Astro.props;
const quoteUrl = `/quotes/${quote.id.toLowerCase()}`;
const description = quoteDescription(quote);
const title = quoteTitle(quote);
const heading = quoteHeading(quote);
const indexableThemeNames = new Set(
  themeGroups().filter(shouldIndexTheme).map((theme) => theme.name),
);
const canonicalThemeNames = [
  ...new Set(quote.themes.map((theme) => canonicalizeTheme(theme))),
];
const primaryTheme =
  canonicalThemeNames.find((theme) => indexableThemeNames.has(theme)) ??
  "Philosophy";
const sameAuthor = relatedByAuthor(quote, 5);
const sameTheme = relatedByTheme(quote, 5);
const { prev, next } = adjacentQuotes(quote);
const citations = citationFormats(quote);
const thinkerGuide = thinkerGuideFor(quote.author, quote.school);
const themeNames = canonicalThemeNames.filter((theme) =>
  indexableThemeNames.has(theme),
);
const primaryThemeGuide = themeGuideFor(primaryTheme);
const themeNotes = themeNames.map((theme) => ({
  name: theme,
  slug: themeSlug(theme),
  note: themeGuideFor(theme)?.intro,
}));
const firstSentences = (text: string, count = 2) =>
  text
    .split(/(?<=[.!?])\s+/)
    .filter(Boolean)
    .slice(0, count)
    .join(" ");
const relatedGuides = guides
  .filter(
    (guide) =>
      guide.thinkers.includes(quote.author) ||
      guide.slug.includes(themeSlug(primaryTheme)) ||
      guide.title.toLowerCase().includes(primaryTheme.toLowerCase()),
  )
  .slice(0, 3);
const thinkerThemeQuotes = quotes.filter(
  (item) =>
    item.author === quote.author &&
    item.themes.some((theme) => canonicalizeTheme(theme) === primaryTheme),
);
const hasIndexableThinkerThemePage = shouldIndexThinkerThemePair({
  author: quote.author,
  theme: primaryTheme,
  quotes: thinkerThemeQuotes,
});

const sourceContext = `The archive attributes this English wording to ${quote.source} and files it under ${quote.school}. That locator distinguishes the passage from loose internet attributions: readers can return to the named work or section to check translation, surrounding argument, and edition-specific wording.`;
const thinkerContext = thinkerGuide
  ? firstSentences(thinkerGuide.overview, 2)
  : `${quote.author} is represented here through sourced English passages associated with ${quote.school}.`;
const readingContext = primaryThemeGuide
  ? `${firstSentences(primaryThemeGuide.overview, 2)} This passage enters that discussion through ${themeNames
      .map((theme) => theme.toLowerCase())
      .join(", ")}.`
  : `This passage is indexed under ${themeNames
      .map((theme) => theme.toLowerCase())
      .join(", ")}. Those labels identify the concepts it can illuminate; they do not replace the argument surrounding it in ${quote.source}.`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quotation",
    text: quote.text,
    inLanguage: "en",
    creator: {
      "@type": isTextTradition(quote.author) ? "CreativeWork" : "Person",
      name: quote.author,
    },
    about: primaryTheme,
    keywords: themeNames,
    citation: quote.source,
    mainEntityOfPage: new URL(quoteUrl, Astro.site),
    dateModified: "2026-08-17",
    isPartOf: {
      "@type": "Collection",
      name: "Philosophy Blind Box",
      url: Astro.site,
    },
    url: new URL(quoteUrl, Astro.site),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Quotes",
        item: new URL("/quotes", Astro.site),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: quote.author,
        item: new URL(`/thinkers/${slugify(quote.author)}`, Astro.site),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: quote.id,
        item: new URL(quoteUrl, Astro.site),
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={quoteUrl}
  image={`/og/quotes/${quote.id.toLowerCase()}.png`}
  type="article"
  schema={schema}
>
  <article class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">{quote.id}</p>
      <h1>{heading}</h1>
      <p>
        {quote.source && quote.source !== "Tradition"
          ? `Verified English quotation. Primary source: ${quote.source}. Theme: ${primaryTheme.toLowerCase()}.`
          : `An English quotation associated with ${quote.school}, organized here under ${primaryTheme.toLowerCase()}.`}
      </p>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/quotes">Quotes</a>
        <span aria-hidden="true">/</span>
        <a href={`/thinkers/${slugify(quote.author)}`}>{quote.author}</a>
        <span aria-hidden="true">/</span>
        <span>{quote.id}</span>
      </nav>
    </header>

    <section class="quote-stage" aria-labelledby="quotation">
      <div class="quote-panel">
        <p class="quote-index">English</p>
        <div>
          <blockquote class="quote-text" id="quotation">
            {quote.text}
          </blockquote>
          <div class="quote-meta">
            <div class="meta-item">
              <span>Thinker</span>
              <strong>
                <a href={`/thinkers/${slugify(quote.author)}`}>{quote.author}</a>
              </strong>
            </div>
            <div class="meta-item">
              <span>School</span>
              <strong>{quote.school}</strong>
            </div>
            <div class="meta-item">
              <span>Source</span>
              <strong>{quote.source || "Tradition"}</strong>
            </div>
            <div class="meta-item">
              <span>Theme</span>
              <strong>
                <a href={themePath(primaryTheme)}>
                  {primaryTheme === "Philosophy" ? "Browse all themes" : primaryTheme}
                </a>
              </strong>
            </div>
          </div>
          <div class="quote-tools">
            <a class="button" href="/#featured-quote">Another quotation</a>
            <a class="button secondary" href={`/thinkers/${slugify(quote.author)}`}>
              More from this thinker
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="quote-depth prose-layout">
      <aside class="prose-aside">
        <p>
          Context and commentary are editorial aids for reading. They do not replace
          the primary text or scholarly commentary.
        </p>
      </aside>
      <div class="prose">
        <h2>Source and attribution</h2>
        <p>{sourceContext}</p>
        <h2>About {quote.author}</h2>
        <p>{thinkerContext}</p>
        <h2>How to read this passage</h2>
        <p>{readingContext}</p>
        {
          themeNotes.length > 0 && (
            <>
              <h2>Concepts in this quote</h2>
              <dl>
                {themeNotes.map((theme) => (
                  <>
                    <dt>
                      <a href={`/themes/${theme.slug}`}>{theme.name}</a>
                    </dt>
                    <dd>
                      {theme.note ??
                        `Compare this passage with other sourced quotations filed under ${theme.name.toLowerCase()}.`}
                    </dd>
                  </>
                ))}
              </dl>
            </>
          )
        }
        <h2>How to cite this quotation</h2>
        <p><strong>APA:</strong> {citations.apa}</p>
        <p><strong>MLA:</strong> {citations.mla}</p>
        <p><strong>Chicago:</strong> {citations.chicago}</p>
      </div>
    </section>

    {
      hasIndexableThinkerThemePage && (
        <p class="related-link">
          <a href={`/thinkers/${slugify(quote.author)}/${themeSlug(primaryTheme)}`}>
            Explore {quote.author} on {primaryTheme.toLowerCase()}
          </a>
        </p>
      )
    }

    {
      sameAuthor.length > 0 && (
        <section class="related-block" aria-labelledby="same-author-title">
          <div class="section-intro">
            <p class="section-label">Same thinker</p>
            <h2 id="same-author-title">More from {quote.author}</h2>
          </div>
          <ol class="quote-list compact-list">
            {sameAuthor.map((item) => (
              <li class="quote-list-item">
                <blockquote>{item.text}</blockquote>
                <footer>
                  <a href={`/quotes/${item.id.toLowerCase()}`}>{item.id}</a>
                  <br />
                  {canonicalizeTheme(item.themes[0] ?? "Philosophy")}
                </footer>
              </li>
            ))}
          </ol>
          <p class="related-link">
            <a href={`/thinkers/${slugify(quote.author)}`}>
              All quotations by {quote.author}
            </a>
          </p>
        </section>
      )
    }

    {
      sameTheme.length > 0 && (
        <section class="related-block" aria-labelledby="same-theme-title">
          <div class="section-intro">
            <p class="section-label">Same theme</p>
            <h2 id="same-theme-title">More on {primaryTheme.toLowerCase()}</h2>
          </div>
          <ol class="quote-list compact-list">
            {sameTheme.map((item) => (
              <li class="quote-list-item">
                <blockquote>{item.text}</blockquote>
                <footer>
                  <a href={`/quotes/${item.id.toLowerCase()}`}>{item.author}</a>
                  <br />
                  {item.school}
                </footer>
              </li>
            ))}
          </ol>
          <p class="related-link">
            <a href={themePath(primaryTheme)}>
              {primaryTheme === "Philosophy"
                ? "Browse all philosophy themes"
                : `Browse the ${primaryTheme.toLowerCase()} theme`}
            </a>
          </p>
        </section>
      )
    }

    {
      relatedGuides.length > 0 && (
        <nav class="guide-related" aria-label="Related guides">
          <p class="eyebrow">Related guides</p>
          <ul>
            {relatedGuides.map((guide) => (
              <li>
                <a href={`/${guide.slug}`}>{guide.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <nav class="quote-pager" aria-label="Adjacent quotations">
      <a href={`/quotes/${prev.id.toLowerCase()}`}>← Previous: {prev.author}</a>
      <a href={`/quotes/${next.id.toLowerCase()}`}>Next: {next.author} →</a>
    </nav>
  </article>
</BaseLayout>
