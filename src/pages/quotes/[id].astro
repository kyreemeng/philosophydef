---
import BaseLayout from "../../layouts/BaseLayout.astro";
import quotes from "../../data/quotes.json";
import {
  adjacentQuotes,
  canonicalizeTheme,
  quoteDescription,
  quoteHeading,
  quoteTitle,
  relatedByAuthor,
  relatedByTheme,
  slugify,
  themeGroups,
  themePath,
  themeSlug,
  thinkerSourcePath,
  truncateWords,
} from "../../lib/content";
import { buildCitations, resolveSource } from "../../lib/citation";
import {
  corpusReviewDate,
  isInVerificationBatch,
  languageCode,
  quoteVerification,
} from "../../data/quote-verification";
import { hasThinkerSourcePage } from "../../data/thinker-sourcing";
import { guides } from "../../data/guides";
import {
  isTextTradition,
  themeGuideFor,
  thinkerGuideFor,
} from "../../data/enrichment";
import {
  shouldIndexQuote,
  shouldIndexTheme,
  shouldIndexThinkerThemePair,
} from "../../lib/indexing";
import { quoteCommentary } from "../../data/quote-commentary";
import { chanMasterNote, textTraditionFor } from "../../data/text-traditions";
import { conceptsForThemes, conceptPath, conceptSlug } from "../../data/concept-glossary";
import { verificationLevelFor, VERIFICATION_LEVELS } from "../../lib/verification";
import { workForQuote } from "../../lib/works";

export function getStaticPaths() {
  return quotes.map((quote) => ({
    params: { id: quote.id.toLowerCase() },
    props: { quote },
  }));
}

const { quote } = Astro.props;
const quoteUrl = `/quotes/${quote.id.toLowerCase()}`;
// Passage-specific commentary, written one quotation at a time. Pages without
// an entry fall back to the theme-level paragraph below, so nothing renders
// empty while the corpus is being filled in.
const commentary = quoteCommentary[quote.id.toUpperCase()];
const description = quoteDescription(quote);
const title = quoteTitle(quote);
const heading = quoteHeading(quote);
const indexable = shouldIndexQuote(quote);
const indexableThemeNames = new Set(
  themeGroups().filter(shouldIndexTheme).map((theme) => theme.name),
);
const canonicalThemeNames = [
  ...new Set(quote.themes.map((theme) => canonicalizeTheme(theme))),
];
const primaryTheme =
  canonicalThemeNames.find((theme) => indexableThemeNames.has(theme)) ??
  "Philosophy";
const sameAuthor = relatedByAuthor(quote, 2);
const sameTheme = relatedByTheme(quote, 2);
const { prev, next } = adjacentQuotes(quote);

/**
 * The verification record, when one exists.
 *
 * Search Console shows every position-1–3 rank this archive has ever held is a
 * “quote source” query, so the material that answers that question belongs on
 * the page a searcher actually lands on — not only on the sourcing hub.
 */
const verification = quoteVerification[quote.id.toUpperCase()];
const level = verificationLevelFor(quote);
const verificationDate =
  verification?.lastVerified ??
  commentary?.written ??
  corpusReviewDate(quote.id, Boolean(commentary));
const originalLanguageCode = verification?.original
  ? languageCode(verification.original.language)
  : undefined;
const inVerificationBatch = isInVerificationBatch(quote.id);

/**
 * The source record is now built from the corpus source, the works registry,
 * and the verification register together.
 *
 * This replaced three paragraphs that rendered on 661, 661, and 662 of the 692
 * quotation pages respectively — the same sentences about divergent wording and
 * uncontested attribution, whether or not the archive held any evidence either
 * way. The register's own header states the rule the page was breaking: "Pages
 * without an entry render the citation block alone rather than filler, because
 * a boilerplate paragraph repeated across 690 pages is the exact thin-content
 * signature that triggered the August quality re-evaluation." The rule is now
 * what the template does.
 *
 * One of those sentences was worse than filler. "Nothing about this passage's
 * attribution is contested in the record this archive consulted" asserts a
 * negative finding on 661 pages that the archive had not checked, which is the
 * opposite of what a page claiming verification should say. Where there is no
 * record, the page now says so — as a labelled status field, not as a claim.
 */
const resolvedSource = resolveSource(quote.source);
const work = resolvedSource.work;
const workPage = workForQuote(quote);
const tradition = textTraditionFor(quote.author);
const chanNote = chanMasterNote(quote.author);
const citations = buildCitations({
  author: quote.author,
  text: quote.text,
  source: quote.source,
  url: quoteUrl,
  accessDate: verificationDate,
});

/**
 * How long the English wording is decides how large the passage can be set. The
 * homepage fits its display type with JavaScript; a static page can do it with
 * a bracket, which costs nothing and works with scripting off.
 */
const wordCount = quote.text.trim().split(/\s+/).filter(Boolean).length;
const lengthTier =
  quote.text.length > 150 || wordCount > 26
    ? "xl"
    : quote.text.length > 100 || wordCount > 17
      ? "long"
      : quote.text.length > 56 || wordCount > 9
        ? "medium"
        : "short";

const authorQuoteCount = quotes.filter((item) => item.author === quote.author).length;
const thinkerHasSourcePage = hasThinkerSourcePage(quote.author, authorQuoteCount);
const thinkerGuide = thinkerGuideFor(quote.author, quote.school);
const themeNames = canonicalThemeNames.filter((theme) =>
  indexableThemeNames.has(theme),
);
const primaryThemeGuide = themeGuideFor(primaryTheme);
const themeNotes = themeNames.map((theme) => ({
  name: theme,
  slug: themeSlug(theme),
  note: themeGuideFor(theme)?.intro,
}));
const firstSentences = (text: string, count = 2) =>
  text
    .split(/(?<=[.!?])\s+/)
    .filter(Boolean)
    .slice(0, count)
    .join(" ");
const relatedGuides = guides
  .filter(
    (guide) =>
      guide.thinkers.includes(quote.author) ||
      guide.slug.includes(themeSlug(primaryTheme)) ||
      guide.title.toLowerCase().includes(primaryTheme.toLowerCase()),
  )
  .slice(0, 3);
const thinkerThemeQuotes = quotes.filter(
  (item) =>
    item.author === quote.author &&
    item.themes.some((theme) => canonicalizeTheme(theme) === primaryTheme),
);
const hasIndexableThinkerThemePage = shouldIndexThinkerThemePair({
  author: quote.author,
  theme: primaryTheme,
  quotes: thinkerThemeQuotes,
});

/**
 * Technical terms this page's own passage trades on, pulled from the glossary
 * by theme. A reader meeting *eudaimonia*, *wu wei*, or *śūnyatā* inside a
 * single quoted sentence has no way to learn that the word is being used
 * technically; this is where the page tells them.
 */
const concepts = conceptsForThemes(canonicalThemeNames, 4);

/**
 * The reading section carries one page-specific sentence and then hands off.
 *
 * A methodological paragraph explaining what a locator is would read the same
 * on all 692 pages, which is the templated-prose failure this rewrite exists to
 * remove. The explanation belongs once, on the sourcing hub, where a reader who
 * wants it will find it; here it is a link. What stays is the part that differs
 * page by page: which work, which section, which tradition.
 */
const sourceContext = `The archive attributes this English wording to ${quote.source} and files it under ${quote.school}.`;
const thinkerContext = thinkerGuide
  ? firstSentences(thinkerGuide.overview, 2)
  : `${quote.author} is represented here through sourced English passages associated with ${quote.school}.`;
const readingContext = primaryThemeGuide
  ? `${firstSentences(primaryThemeGuide.overview, 2)} This passage enters that discussion through ${themeNames
      .map((theme) => theme.toLowerCase())
      .join(", ")}.`
  : `This passage is indexed under ${themeNames
      .map((theme) => theme.toLowerCase())
      .join(", ")}. Those labels identify the concepts it can illuminate; they do not replace the argument surrounding it in ${quote.source}.`;

/**
 * A short, visible FAQ answering the queries Search Console shows readers
 * arrive with, and one entry per piece of material the archive actually holds.
 * An answer is only written where there is something to answer with.
 */
const shortQuote = truncateWords(quote.text, 8);
/**
 * The FAQ answer is built only from facts that differ page by page.
 *
 * An earlier draft closed every answer with one of two fixed sentences
 * explaining what a locator establishes, which put identical prose on several
 * hundred pages and repeated the reading section verbatim. Anything that would
 * read the same on the next page belongs in the section body or on the hub,
 * not in an answer that claims to answer *this* question.
 */
const sourceAnswer = `“${shortQuote}” comes from ${citations.workTitle}${
  resolvedSource.displayLocus ? `, ${resolvedSource.displayLocus}` : ""
}${work?.year ? ` (${work.year})` : ""}, attributed to ${quote.author}.`;

const faq = [
  {
    question: `What is the source of the quotation “${shortQuote}”?`,
    answer: sourceAnswer,
  },
  {
    question: `What does ${quote.author} mean by ${primaryTheme.toLowerCase()}?`,
    answer: readingContext,
  },
  ...(verification?.variants?.length
    ? [
        {
          question: `Is the wording of this ${quote.author} quotation commonly changed?`,
          answer: `The wording recorded here is “${quote.text}” Forms in circulation that differ: ${verification.variants.join(
            " / ",
          )}${verification.original ? ` The ${verification.original.language} reads “${verification.original.text}”` : ""}`,
        },
      ]
    : []),
  ...(verification
    ? [
        {
          question: `Is this quotation attributed correctly?`,
          answer: verification.attribution,
        },
      ]
    : []),
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quotation",
    text: quote.text,
    inLanguage: "en",
    creator: {
      "@type": isTextTradition(quote.author) ? "CreativeWork" : "Person",
      name: quote.author,
    },
    about: primaryTheme,
    keywords: themeNames,
    citation: {
      "@type": "CreativeWork",
      name: citations.workTitle,
      ...(work?.year ? { dateCreated: work.year } : {}),
      ...(work?.original
        ? { inLanguage: work.original.languageTag, alternateName: work.original.text }
        : {}),
      ...(resolvedSource.displayLocus ? { description: resolvedSource.displayLocus } : {}),
      ...(originalLanguageCode
        ? { inLanguage: originalLanguageCode, text: verification?.original?.text }
        : {}),
    },
    mainEntityOfPage: new URL(quoteUrl, Astro.site),
    dateModified: verificationDate,
    isPartOf: {
      "@type": "Collection",
      name: "Philosophy Defined",
      url: Astro.site,
    },
    url: new URL(quoteUrl, Astro.site),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Quotes",
        item: new URL("/quotes", Astro.site),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: quote.author,
        item: new URL(`/thinkers/${slugify(quote.author)}`, Astro.site),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: quote.id,
        item: new URL(quoteUrl, Astro.site),
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];

/** Sections that will actually render, so the contents list matches the page. */
const contents = [
  { id: "source-record", label: "Source record" },
  ...(verification?.original || verification?.variants?.length
    ? [{ id: "exact-wording", label: "Exact wording" }]
    : []),
  ...(verification ? [{ id: "attribution", label: "Attribution notes" }] : []),
  { id: "reading", label: "Reading the source" },
  ...(commentary ? [{ id: "interpretation", label: "Interpretation" }] : []),
  ...(concepts.length ? [{ id: "concepts", label: "Terms in this passage" }] : []),
  { id: "citing", label: "How to cite" },
  { id: "faq", label: "Questions" },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={quoteUrl}
  image={`/og/quotes/${quote.id.toLowerCase()}.png`}
  type="article"
  schema={schema}
  robots={indexable ? undefined : "noindex, follow, max-image-preview:large"}
>
  <article class="page-shell quote-page">
    <header class="quote-masthead">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/quotes">Quotes</a>
        <span aria-hidden="true">/</span>
        <a href={`/thinkers/${slugify(quote.author)}`}>{quote.author}</a>
        <span aria-hidden="true">/</span>
        <span>{quote.id}</span>
      </nav>

      {/* The passage itself is the page's subject, so it is the page's largest
          heading rather than a truncated echo of it sitting above a second,
          larger copy of the same words. */}
      <h1 class="quote-headline" data-length={lengthTier}>{heading}</h1>

      {/* The locator, in the form a philosophy paper uses. This line is the
          archive's claim, so it sits directly under the passage rather than at
          the foot of the page among the style formats. */}
      <p class="quote-locator">{citations.primary}</p>

      <dl class="quote-meta">
        <div class="meta-item">
          <dt>Thinker</dt>
          <dd>
            <a href={`/thinkers/${slugify(quote.author)}`}>{quote.author}</a>
          </dd>
        </div>
        <div class="meta-item">
          <dt>Tradition</dt>
          <dd>{quote.school}</dd>
        </div>
        <div class="meta-item">
          <dt>Work</dt>
          <dd>
            {workPage ? (
              <a href={workPage.path}>{citations.workTitle}</a>
            ) : (
              citations.workTitle
            )}
          </dd>
        </div>
        <div class="meta-item">
          <dt>Theme</dt>
          <dd>
            <a href={themePath(primaryTheme)}>
              {primaryTheme === "Philosophy" ? "All themes" : primaryTheme}
            </a>
          </dd>
        </div>
      </dl>

      <div class="quote-tools">
        <a class="button" href="/#featured-quote">Another quotation</a>
        <a class="button secondary" href={`/thinkers/${slugify(quote.author)}`}>
          More from this thinker
        </a>
        {/* Every passage links the sourcing hub. The hub is the page this
            archive is building the “who said this” line around, and it can
            only rank if several hundred pages point at it; a passage page
            pointing at “where to check a quotation” is a topical link, not
            a footer link. */}
        <a class="button secondary" href="/quote-source">
          {inVerificationBatch
            ? "How to verify this source"
            : "Trace a quotation to its source"}
        </a>
      </div>
    </header>

    <div class="quote-layout">
      {/* Long pages need a way through them. Guides have had one; quotation
          pages grew to eight sections without. */}
      <aside class="quote-contents" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <ol>
          {contents.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
        </ol>
        <p class="quote-contents-status">
          <span class={verification ? "status status-verified" : "status"}>
            {VERIFICATION_LEVELS[level].label}
          </span>
          <span>
            {verification
              ? `Last verified: ${verification.lastVerified}`
              : `Not yet collated · ${verificationDate}`}
          </span>
          <a href="/about#verification-levels">What these levels mean</a>
        </p>
      </aside>

      <div class="quote-sections">
        <section id="source-record" class="quote-block" aria-labelledby="source-record-title">
          <h2 id="source-record-title">Source record</h2>
          <dl class="source-record">
            <div>
              <dt>Work</dt>
              <dd>
                {workPage ? (
                  <a href={workPage.path}>
                    {citations.workTitle}
                  </a>
                ) : (
                  citations.workTitle
                )}
                {work?.original && (
                  <> · <span lang={work.original.languageTag}>{work.original.text}</span></>
                )}
              </dd>
            </div>
            <div>
              <dt>Passage</dt>
              <dd>
                {resolvedSource.displayLocus || (
                  <span class="muted">
                    No passage locator recorded in the corpus for this entry.
                  </span>
                )}
              </dd>
            </div>
            <div>
              <dt>Composed</dt>
              <dd>{work?.year ?? "Not established for this work in the registry"}</dd>
            </div>
            <div>
              <dt>Originally written in</dt>
              <dd>
                {verification?.original?.language ??
                  work?.original?.language ??
                  tradition?.language ?? (
                    <span class="muted">Not recorded</span>
                  )}
              </dd>
            </div>
            <div>
              <dt>English wording</dt>
              <dd>
                {work?.translator ? (
                  <>From {work.translator}</>
                ) : (
                  <span class="muted">
                    Translator not recorded — the archive holds the English text
                    but not the edition it came from.
                  </span>
                )}
              </dd>
            </div>
            <div>
              <dt>Verification status</dt>
              <dd>
                {verification
                  ? `${VERIFICATION_LEVELS[level].description} Last verified ${verification.lastVerified}.`
                  : `${VERIFICATION_LEVELS[level].description} Recorded ${verificationDate}.`}
              </dd>
            </div>
          </dl>

          {tradition && (
            <details class="source-note">
              <summary>How this text is transmitted</summary>
              <p>{tradition.form}</p>
              <p>{tradition.transmission}</p>
              <p>
                <strong>Reading caution.</strong> {tradition.readingNote}
              </p>
            </details>
          )}
          {chanNote && (
            <details class="source-note">
              <summary>What the attribution rests on</summary>
              <p>{chanNote}</p>
            </details>
          )}
          {work?.note && (
            <details class="source-note">
              <summary>About this citation</summary>
              <p>{work.note}</p>
            </details>
          )}
        </section>

        {(verification?.original || verification?.variants?.length) && (
          <section id="exact-wording" class="quote-block" aria-labelledby="exact-wording-title">
            <h2 id="exact-wording-title">Exact wording</h2>
            <dl class="wording-list">
              <div>
                <dt>English (as recorded here)</dt>
                <dd>“{quote.text}”</dd>
              </div>
              {verification?.original && (
                <div>
                  <dt>{verification.original.language}</dt>
                  <dd lang={originalLanguageCode ?? "und"}>
                    “{verification.original.text}”
                  </dd>
                </div>
              )}
            </dl>
            {verification?.original?.note && <p>{verification.original.note}</p>}
            {verification?.variants?.length ? (
              <>
                <h3>Forms in circulation that differ</h3>
                <ul class="variant-list">
                  {verification.variants.map((variant) => <li>“{variant}”</li>)}
                </ul>
              </>
            ) : null}
          </section>
        )}

        {verification && (
          <section id="attribution" class="quote-block" aria-labelledby="attribution-title">
            <h2 id="attribution-title">Attribution notes</h2>
            <p>{verification.attribution}</p>
            <p class="related-link">
              {thinkerHasSourcePage ? (
                <a href={thinkerSourcePath(quote.author)}>
                  How to cite and check {quote.author} quotations
                </a>
              ) : (
                <a href="/quote-source">How to trace any quotation to its source</a>
              )}
            </p>
          </section>
        )}

        <section id="reading" class="quote-block" aria-labelledby="reading-title">
          <h2 id="reading-title">Reading the cited source</h2>
          <p>{sourceContext}</p>
          <p class="related-link">
            <a href="/sourcing-method#locators">
              What a locator tells you, and what it does not
            </a>
            {" · "}
            <a href="/quote-source">How this archive traces a quotation</a>
          </p>
          <h3>About {quote.author}</h3>
          <p>{thinkerContext}</p>
        </section>

        {commentary ? (
          <section id="interpretation" class="quote-block" aria-labelledby="interpretation-title">
            <h2 id="interpretation-title">Interpretation</h2>
            <p>{commentary.interpretation}</p>
            <h3>Why it matters</h3>
            <p>{commentary.insight}</p>
          </section>
        ) : (
          <section class="quote-block" aria-labelledby="how-to-read-title">
            <h2 id="how-to-read-title">How to read this passage</h2>
            <p>{readingContext}</p>
          </section>
        )}

        {
          concepts.length > 0 && (
            <section id="concepts" class="quote-block" aria-labelledby="concepts-title">
              <h2 id="concepts-title">Terms in this passage</h2>
              <dl class="concept-list">
                {concepts.map((concept) => (
                  <div class="concept" id={`concept-${conceptSlug(concept)}`}>
                    <dt>
                      <span class="concept-term">{concept.term}</span>
                      <span class="concept-language">
                        {concept.language}
                        {concept.original && (
                          <>
                            {" · "}
                            <span lang={concept.languageTag ?? "und"}>
                              {concept.original}
                            </span>
                          </>
                        )}
                      </span>
                      <span class="concept-gloss">{concept.gloss}</span>
                    </dt>
                    <dd>
                      <a href={conceptPath(concept)}>
                        What {concept.term} means, and the reading it is
                        commonly given
                      </a>
                    </dd>
                  </div>
                ))}
              </dl>
              {
                themeNotes.length > 0 && (
                  <p class="related-link">
                    {themeNotes.map((theme, index) => (
                      <>
                        {index > 0 && " · "}
                        <a href={`/themes/${theme.slug}`}>{theme.name}</a>
                      </>
                    ))}
                  </p>
                )
              }
            </section>
          )
        }

        <section id="citing" class="quote-block" aria-labelledby="citing-title">
          <h2 id="citing-title">How to cite this quotation</h2>
          <dl class="citation-list">
            <div>
              <dt>Primary text</dt>
              <dd>{citations.primary}</dd>
            </div>
            <div>
              <dt>APA 7</dt>
              <dd>{citations.apa}</dd>
            </div>
            <div>
              <dt>MLA 9</dt>
              <dd>{citations.mla}</dd>
            </div>
            <div>
              <dt>Chicago 17</dt>
              <dd>{citations.chicago}</dd>
            </div>
          </dl>
          <p class="section-note">
            {citations.speaker ? (
              <>
                {citations.citedAuthor} is cited as the work's author:{" "}
                {citations.speaker} speaks the passage rather than writing it.{" "}
              </>
            ) : null}
            {citations.translationUnrecorded
              ? "No translator is recorded for this wording."
              : "The wording rests on the translation recorded above."}{" "}
            <a href="/sourcing-method#locators">
              What to do when the edition matters
            </a>
          </p>
        </section>

        <section id="faq" class="quote-block" aria-labelledby="faq-title">
          <h2 id="faq-title">Questions readers arrive with</h2>
          {
            faq.map((entry) => (
              <div class="faq-item">
                <h3>{entry.question}</h3>
                <p>{entry.answer}</p>
              </div>
            ))
          }
        </section>
      </div>
    </div>

    {/* An ordered path rather than a set of unrelated links: a reader who
        wants more should be able to go outward in one direction —
        thinker, then theme, then the concept, then the guide that frames it. */}
    <nav class="reading-path" aria-label="Continue reading">
      <p class="eyebrow">Continue</p>
      <ol>
        <li>
          <a href={`/thinkers/${slugify(quote.author)}`}>
            More passages by {quote.author}
          </a>
        </li>
        {workPage && (
          <li>
            <a href={workPage.path}>
              Everything from {citations.workTitle}
            </a>
          </li>
        )}
        <li>
          <a href={themePath(primaryTheme)}>
            Everything on {primaryTheme.toLowerCase()}
          </a>
        </li>
        {concepts.length > 0 && (
          <li>
            <a href={`#concept-${conceptSlug(concepts[0])}`}>
              What “{concepts[0].term}” means
            </a>
          </li>
        )}
        {relatedGuides.length > 0 && (
          <li>
            <a href={`/${relatedGuides[0].slug}`}>{relatedGuides[0].title}</a>
          </li>
        )}
        {hasIndexableThinkerThemePage && (
          <li>
            <a href={`/thinkers/${slugify(quote.author)}/${themeSlug(primaryTheme)}`}>
              {quote.author} on {primaryTheme.toLowerCase()}
            </a>
          </li>
        )}
      </ol>
    </nav>

    {
      sameAuthor.length > 0 && (
        <section class="related-block" aria-labelledby="same-author-title">
          <div class="section-intro">
            <p class="section-label">Same thinker</p>
            <h2 id="same-author-title">More from {quote.author}</h2>
          </div>
          <ol class="quote-list compact-list">
            {sameAuthor.map((item) => (
              <li class="quote-list-item">
                <blockquote>{item.text}</blockquote>
                <footer>
                  {/* Anchors used to be the bare archive ID ("Q0148"), which told
                      Google nothing about the destination page. The opening words
                      of the target passage are the most specific internal anchor
                      this page can emit for it. */}
                  <a href={`/quotes/${item.id.toLowerCase()}`}>
                    “{truncateWords(item.text, 8)}” — source & context
                  </a>
                  <br />
                  {canonicalizeTheme(item.themes[0] ?? "Philosophy")}
                </footer>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      sameTheme.length > 0 && (
        <section class="related-block" aria-labelledby="same-theme-title">
          <div class="section-intro">
            <p class="section-label">Same theme</p>
            <h2 id="same-theme-title">More on {primaryTheme.toLowerCase()}</h2>
          </div>
          <ol class="quote-list compact-list">
            {sameTheme.map((item) => (
              <li class="quote-list-item">
                <blockquote>{item.text}</blockquote>
                <footer>
                  {/* Entity + excerpt anchor: the author name alone repeated
                      across a five-item list, and the ID it replaced, both
                      undersold the destination page to crawlers. */}
                  <a href={`/quotes/${item.id.toLowerCase()}`}>
                    {item.author}: “{truncateWords(item.text, 8)}”
                  </a>
                  <br />
                  {item.school}
                </footer>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      relatedGuides.length > 0 && (
        <nav class="guide-related" aria-label="Related guides">
          <p class="eyebrow">Related guides</p>
          <ul>
            {relatedGuides.map((guide) => (
              <li>
                <a href={`/${guide.slug}`}>{guide.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <nav class="quote-pager" aria-label="Adjacent quotations">
      <a href={`/quotes/${prev.id.toLowerCase()}`}>← Previous: {prev.author}</a>
      <a href={`/quotes/${next.id.toLowerCase()}`}>Next: {next.author} →</a>
    </nav>
  </article>
</BaseLayout>
