---
import BaseLayout from "../../layouts/BaseLayout.astro";
import quotes from "../../data/quotes.json";

const firstPage = quotes.slice(0, 24);
const allThemes = [...new Set(quotes.flatMap((quote) => quote.themes))].sort();
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Philosophy Quote Archive",
  description:
    "Browse curated English philosophy quotations by thinker, theme, and source.",
  url: new URL("/quotes", Astro.site),
  numberOfItems: quotes.length,
};
---

<BaseLayout
  title="Philosophy Quote Archive | Philosophy Blind Box"
  description={`Browse ${quotes.length.toLocaleString("en-US")} curated English philosophy quotations, organized by thinker and theme.`}
  canonical="/quotes"
  schema={schema}
>
  <div class="page-shell">
    <header class="page-intro">
      <h1>The quotation archive</h1>
      <p>
        Search by thinker, theme, source, or a word from the English passage.
      </p>
    </header>

    <section aria-label="Quote archive">
      <div class="filter-bar">
        <div class="field">
          <label for="quote-search">Search the archive</label>
          <input
            id="quote-search"
            type="search"
            name="q"
            placeholder="Try Plato, freedom, or wonder"
            autocomplete="off"
          />
        </div>
        <div class="field">
          <label for="theme-filter">Theme</label>
          <select id="theme-filter">
            <option value="">All themes</option>
            {allThemes.map((theme) => <option value={theme}>{theme}</option>)}
          </select>
        </div>
      </div>
      <p class="results-summary" id="results-summary">
        Showing 24 of {quotes.length.toLocaleString("en-US")} quotations
      </p>
      <ol class="quote-list" id="quote-list">
        {
          firstPage.map((quote) => (
            <li class="quote-list-item">
              <blockquote>{quote.text}</blockquote>
              <footer>
                <a href={`/quotes/${quote.id.toLowerCase()}`}>{quote.author}</a>
                <br />
                {quote.themes[0] ?? quote.school}
              </footer>
            </li>
          ))
        }
      </ol>
      <button class="load-more" id="load-more" type="button">Show more</button>
    </section>
  </div>

  <script id="archive-data" type="application/json" set:html={JSON.stringify(quotes)} />
  <script>
    const archive = JSON.parse(
      document.querySelector("#archive-data")?.textContent || "[]",
    );
    const list = document.querySelector("#quote-list");
    const search = document.querySelector("#quote-search");
    const themeFilter = document.querySelector("#theme-filter");
    const summary = document.querySelector("#results-summary");
    const loadMore = document.querySelector("#load-more");
    let limit = 24;
    let filtered = archive;

    function quoteCard(quote) {
      const item = document.createElement("li");
      item.className = "quote-list-item";

      const blockquote = document.createElement("blockquote");
      blockquote.textContent = quote.text;

      const footer = document.createElement("footer");
      const link = document.createElement("a");
      link.href = `/quotes/${quote.id.toLowerCase()}`;
      link.textContent = quote.author;
      footer.append(
        link,
        document.createElement("br"),
        quote.themes[0] ?? quote.school,
      );

      item.append(blockquote, footer);
      return item;
    }

    function applyFilters() {
      const term = search?.value.trim().toLocaleLowerCase() || "";
      const selectedTheme = themeFilter?.value || "";
      filtered = archive.filter((quote) => {
        const searchable = [
          quote.text,
          quote.author,
          quote.school,
          quote.source,
          ...quote.themes,
        ]
          .join(" ")
          .toLocaleLowerCase();
        return (
          (!term || searchable.includes(term)) &&
          (!selectedTheme || quote.themes.includes(selectedTheme))
        );
      });
      limit = 24;
      render();
    }

    function render() {
      if (!list) return;
      list.replaceChildren();
      const visible = filtered.slice(0, limit);
      if (!visible.length) {
        const empty = document.createElement("li");
        empty.className = "empty-state";
        empty.innerHTML =
          "<strong>No matching quotations</strong><p>Try another thinker, a wider theme, or a different search term.</p>";
        list.append(empty);
      } else {
        list.append(...visible.map(quoteCard));
      }
      if (summary) {
        summary.textContent = `Showing ${visible.length.toLocaleString()} of ${filtered.length.toLocaleString()} quotations`;
      }
      if (loadMore) {
        loadMore.hidden = visible.length >= filtered.length;
      }
    }

    const params = new URLSearchParams(location.search);
    if (search && params.get("q")) search.value = params.get("q");
    if (themeFilter && params.get("theme")) themeFilter.value = params.get("theme");
    search?.addEventListener("input", applyFilters);
    themeFilter?.addEventListener("change", applyFilters);
    loadMore?.addEventListener("click", () => {
      limit += 24;
      render();
    });
    applyFilters();
  </script>
</BaseLayout>
