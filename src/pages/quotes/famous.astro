---
/**
 * The famous-quotes collection.
 *
 * “Famous” here means historically recognized: lines that have been read,
 * quoted, argued with, and misquoted for centuries. That is a different
 * promise from /quotes/best (editorial judgement about argumentative value)
 * and /quotes/short (a length constraint), and the page says so — the three
 * collections used to read as the same list with three URLs, which is how
 * near-duplicate archive pages end up competing with each other for the same
 * intent.
 *
 * The intro also does the one thing a famous-quotes page on this archive
 * should do that no aggregator can: name the gap between how widely a line
 * circulates and how well it is attested, and link the sourcing work.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import quotes from "../../data/quotes.json";
import { canonicalizeTheme, truncateWords } from "../../lib/content";
import { pageSeoOverrides } from "../../data/seo-overrides";

const famousAuthors = new Set([
  "Socrates",
  "Plato",
  "Aristotle",
  "Confucius",
  "Laozi",
  "Marcus Aurelius",
  "Seneca",
  "Epictetus",
  "Friedrich Nietzsche",
  "Immanuel Kant",
  "René Descartes",
  "Bertrand Russell",
]);

const selected = quotes
  .filter((quote) => famousAuthors.has(quote.author) && quote.text.length <= 180)
  .slice(0, 48);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Famous Philosophy Quotes",
    description:
      "Famous philosophy quotes in verified English renderings from Socrates, Plato, Aristotle, Confucius, the Stoics, Nietzsche, and more.",
    url: new URL("/quotes/famous", Astro.site),
    numberOfItems: selected.length,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Quotes", item: new URL("/quotes", Astro.site) },
      {
        "@type": "ListItem",
        position: 2,
        name: "Famous philosophy quotes",
        item: new URL("/quotes/famous", Astro.site),
      },
    ],
  },
];

const seo = pageSeoOverrides["/quotes/famous"] ?? {};
---

<BaseLayout
  title={seo.title ?? "Famous Philosophy Quotes | Socrates, Stoics & Confucius"}
  description={
    seo.description ??
    "Famous philosophy quotes in clear English—Socrates, Plato, Aristotle, Confucius, Marcus Aurelius, Nietzsche, and other enduring thinkers, with sources."
  }
  canonical="/quotes/famous"
  schema={schema}
>
  <div class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">Curated selection</p>
      <h1>Famous philosophy quotes</h1>
      <p>
        A gallery of widely recognized passages — lines that have been read,
        taught, and argued with for centuries. Each one links to a full archive
        entry that names the work, the passage, and the edition it comes from.
      </p>
    </header>

    <div class="prose-layout">
      <aside class="prose-aside">
        <p>
          Famous and well-sourced are different properties. A line can be
          famous because it circulates, and a famous line can be a compression
          of something the philosopher actually wrote. The archive entries
          behind these passages record both: where the words sit, and what
          forms circulate in their place.
        </p>
      </aside>
      <article class="prose">
        <h2>What makes a philosophy quote famous</h2>
        <p>
          Not brevity, and not comfort. The passages on this page survived
          because they carry an argument in a form that sticks: Socrates
          refusing exile rather than stop examining lives, Marcus Aurelius
          telling himself to get out of bed, Descartes locating his own
          existence inside the one doubt he could not shake. Fame in
          philosophy is usually the fame of a position a reader can still take
          sides on.
        </p>
        <p>
          It also makes them the most misquoted sentences in the language.
          “I know that I know nothing” is a later compression of a more
          careful claim; “knowledge is power” drops the clause that made
          Bacon's aphorism an argument. If you plan to quote one of these
          lines in print, the archive entry — not this gallery — is the thing
          to cite, because only the entry carries the locator and the
          attribution notes.
        </p>
        <p class="related-link">
          Suspect a famous line's attribution? <a href="/quote-source">
            Trace it to its source</a> or check the{" "}
          <a href="/misattributed-quotes">misattributed register</a>.
        </p>
      </article>
    </div>

    <ol class="quote-list">
      {
        selected.map((quote) => (
          <li class="quote-list-item">
            <blockquote>{quote.text}</blockquote>
            <footer>
              <a href={`/quotes/${quote.id.toLowerCase()}`}>
                {quote.author}: “{truncateWords(quote.text, 8)}” — source &amp; context
              </a>
              <br />
              {canonicalizeTheme(quote.themes[0] ?? quote.school)}
            </footer>
          </li>
        ))
      }
    </ol>

    <p class="related-link">
      For different selections, try the <a href="/quotes/best">best quotes</a>
      (editorial picks for argumentative value) or the
      <a href="/quotes/short">short quotes</a> (compact lines for teaching and
      sharing) — or continue in the <a href="/quotes">full archive</a>, the
      <a href="/works">works index</a>, or
      <a href="/quotes/about">quotes about feeling</a>.
    </p>
  </div>
</BaseLayout>
