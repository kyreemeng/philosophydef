---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Philosophy Defined"
  description="This page could not be found in the Philosophy Defined archive."
  canonical="/404"
  robots="noindex, follow"
>
  <div class="page-shell">
    <header class="page-intro">
      <h1>Page not found</h1>
      <p>
        This address is not in the archive. Return to a random quotation, or
        continue browsing by thinker and theme.
      </p>
      <div class="hero-actions">
        <a class="button" href="/">A random quotation</a>
        <a class="button secondary" href="/quotes">Browse the archive</a>
      </div>
    </header>
  </div>
</BaseLayout>
