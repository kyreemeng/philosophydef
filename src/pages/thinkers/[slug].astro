---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  thinkerGroups,
  thinkerThemePairs,
  canonicalizeTheme,
  themeGroups,
  themePath,
  thinkerSourcePath,
  slugify,
  truncateWords,
  type Quote,
} from "../../lib/content";
import { thinkerGuideFor, defaultThinkerGuide, isTextTradition } from "../../data/enrichment";
import {
  shouldIndexTheme,
  shouldIndexThinker,
  shouldIndexThinkerThemePair,
} from "../../lib/indexing";
import { pageSeoOverrides } from "../../data/seo-overrides";
import HubEssay from "../../components/HubEssay.astro";
import { hubEssays } from "../../data/hub-essays";
import { hasThinkerSourcePage, thinkerSourcing } from "../../data/thinker-sourcing";
import { referencesFor } from "../../data/thinker-references";
import { quoteVerification } from "../../data/quote-verification";
import { workEntries } from "../../lib/works";
import { conceptsForThemes, conceptPath, conceptSlug } from "../../data/concept-glossary";
import { schools as schoolPages } from "../schools/[slug].astro";

export function getStaticPaths() {
  return thinkerGroups().map((thinker) => ({
    params: { slug: thinker.slug },
    props: { thinker },
  }));
}

const { thinker } = Astro.props;
const pageUrl = `/thinkers/${thinker.slug}`;
const indexable = shouldIndexThinker(thinker);
const guide =
  thinkerGuideFor(thinker.name) ??
  defaultThinkerGuide(
    thinker.name,
    thinker.quotes[0]?.school ?? "Philosophy",
    [...new Set(thinker.quotes.flatMap((quote) => quote.themes.map((theme) => canonicalizeTheme(theme))))],
  );
const themeCounts = new Map<string, number>();
const indexableThemeNames = new Set(
  themeGroups().filter(shouldIndexTheme).map((theme) => theme.name),
);
for (const quote of thinker.quotes) {
  const theme = canonicalizeTheme(quote.themes[0] ?? "Philosophy");
  if (!indexableThemeNames.has(theme)) continue;
  themeCounts.set(theme, (themeCounts.get(theme) ?? 0) + 1);
}
const topThemes = [...themeCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12);
const indexedPairs = thinkerThemePairs(1).filter(
  (pair) =>
    pair.authorSlug === thinker.slug && shouldIndexThinkerThemePair(pair),
);

const asText = isTextTradition(thinker.name);
const entityId = new URL(`${pageUrl}#${asText ? "work" : "person"}`, Astro.site).href;

/**
 * Sources & further reading. The sourcing-method page says the archive checks
 * against critical editions, SEP, and IEP; these links put that claim on the
 * page itself, where a reader can act on it.
 */
const references = referencesFor(thinker.name);
const sourcing = thinkerSourcing[thinker.name];
const thinkerHasSourcePage = hasThinkerSourcePage(thinker.name, thinker.quotes.length);

/**
 * The original languages this thinker's verified passages were checked in,
 * plus the citation system the corpus uses. A reader who wants to quote
 * responsibly needs both, and neither is recoverable from the biography.
 */
const originalLanguages = [
  ...new Set(
    thinker.quotes
      .map((quote) => quoteVerification[quote.id.toUpperCase()]?.original?.language)
      .filter(Boolean),
  ),
];
const showLanguageSection = Boolean(
  originalLanguages.length || sourcing || thinkerHasSourcePage,
);

/**
 * This thinker's works that have their own page, so "Major works" is a path
 * into the Work layer rather than a bare list of titles.
 */
const worksByThinker = workEntries()
  .filter((entry) => entry.authors.includes(thinker.name))
  .sort((a, b) => b.quotes.length - a.quotes.length)
  .slice(0, 8);

/**
 * Related thinkers: people filed under the same school, ordered by how much
 * the archive holds of them, and limited to indexable pages so no link here
 * points at a noindex destination.
 */
const thinkerSchools = new Set(thinker.quotes.map((quote) => quote.school));
const sharedSchoolCount = (other: { quotes: Quote[] }) =>
  other.quotes.filter((quote) => thinkerSchools.has(quote.school)).length;
const relatedThinkers = thinkerGroups()
  .filter(
    (other) =>
      other.name !== thinker.name &&
      shouldIndexThinker(other) &&
      sharedSchoolCount(other) > 0,
  )
  .sort((a, b) => sharedSchoolCount(b) - sharedSchoolCount(a))
  .slice(0, 6);

/**
 * The published school hub for this thinker, when the corpus labels match one
 * of the curated school pages. A thinker page should hand the reader to the
 * tradition as well as the themes — the school hub is where the wider
 * lineage lives.
 */
const schoolLabelCounts = new Map<string, number>();
for (const quote of thinker.quotes) {
  schoolLabelCounts.set(quote.school, (schoolLabelCounts.get(quote.school) ?? 0) + 1);
}
const dominantSchool = [...schoolLabelCounts.entries()].sort(
  (a, b) => b[1] - a[1],
)[0]?.[0];
const matchingSchool = dominantSchool
  ? schoolPages.find((school) =>
      thinker.quotes.some((quote) => school.match(quote.school, quote.author)),
    )
  : undefined;

/**
 * The technical terms this thinker's passages trade on, pulled from the
 * glossary by their archive themes: *aretē* for Aristotle, *wu wei* for
 * Laozi, *conatus* for Spinoza. Entity pages that list themes but not terms
 * stop one step short of the vocabulary the quotes actually use.
 */
const thinkerConcepts = conceptsForThemes(
  topThemes.map(([theme]) => theme),
  6,
);
const mainEntity = asText
  ? {
      "@id": entityId,
      "@type": "CreativeWork",
      name: thinker.name,
      genre: guide.school,
      about: guide.knowsAbout,
      inLanguage: "en",
      description: guide.overview,
    }
  : {
      "@id": entityId,
      "@type": "Person",
      name: thinker.name,
      ...(guide.overview ? { description: guide.overview } : {}),
      ...(guide.jobTitle ? { jobTitle: guide.jobTitle } : {}),
      ...(guide.birthDate ? { birthDate: guide.birthDate } : {}),
      ...(guide.deathDate ? { deathDate: guide.deathDate } : {}),
      ...(guide.knowsAbout ? { knowsAbout: guide.knowsAbout } : {}),
      ...(guide.school ? { affiliation: guide.school } : {}),
    };

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${thinker.name} Philosophy Quotes`,
    url: new URL(pageUrl, Astro.site),
    about: { "@id": entityId },
    numberOfItems: thinker.quotes.length,
    ...(hubEssays[pageUrl] ? { dateModified: hubEssays[pageUrl].updated } : {}),
  },
  {
    "@context": "https://schema.org",
    ...mainEntity,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Thinkers",
        item: new URL("/thinkers", Astro.site),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: thinker.name,
        item: new URL(pageUrl, Astro.site),
      },
    ],
  },
];
const topThemeNames = topThemes.map(([theme]) => theme).slice(0, 3);
const themePhrase =
  topThemeNames.length > 0
    ? ` Themes include ${topThemeNames.map((t) => t.toLowerCase()).join(", ")}.`
    : "";
const seo = pageSeoOverrides[pageUrl] ?? {};
const essay = hubEssays[pageUrl];
/**
 * Search Console consistently shows single-digit-to-twenty positions for
 * “{thinker} quotes” queries on pages still carrying the generic brand title.
 * Against established quote aggregators, the only differentiator this archive
 * can put in a search snippet is editorial: an exact passage count and the
 * promise of cited sources. The brand name is appended only when the 60-character
 * window has room for it — for long names the verified-passage signal earns the
 * click and the truncated tail would just waste it.
 *
 * “Sourced” rather than “Verified” in the title: every passage names its
 * source, while the wording checks are graded per page (see
 * lib/verification.ts). A title claiming verification for the lot would
 * promise what the per-page status lines may qualify.
 */
const passageCount = thinker.quotes.length;
const passageNoun = passageCount === 1 ? "Passage" : "Passages";
const sourceNoun = passageCount === 1 ? "Source" : "Sources";
const countTitle =
  passageCount === 1
    ? `${thinker.name} Quotes — Sourced ${passageNoun} with ${sourceNoun}`
    : `${thinker.name} Quotes — ${passageCount} Sourced ${passageNoun} & ${sourceNoun}`;
const brandSuffix = " | Philosophy Blind Box";
const pageTitle =
  seo.title ??
  (countTitle.length + brandSuffix.length <= 60
    ? countTitle + brandSuffix
    : countTitle);
const pageDescription =
  seo.description ??
  `${thinker.name} quotes: read ${thinker.quotes.length} verified English philosophy quotations${guide ? ` (${guide.lifespan})` : ""}, each with its cited source.${themePhrase}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  schema={schema}
  robots={indexable ? undefined : "noindex, follow, max-image-preview:large"}
>
  <div class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">Thinker</p>
      <h1>{thinker.name} quotes</h1>
      <p>
        {thinker.quotes.length}{" "}
        {thinker.quotes.length === 1 ? "passage" : "passages"} in English
        {guide ? ` · ${guide.lifespan} · ${guide.school}` : ""}.
      </p>
      {(essay || thinkerHasSourcePage) && (
        <p class="related-link">
          {essay && <a href="#hub-essay-title">{essay.title}</a>}
          {essay && thinkerHasSourcePage && " · "}
          {thinkerHasSourcePage && (
            <a href={thinkerSourcePath(thinker.name)}>
              How to cite and check {thinker.name} quotations
            </a>
          )}
        </p>
      )}
    </header>

    {
      guide && (
        <div class="prose-layout">
          <aside class="prose-aside">
            <p>{guide.lifespan}</p>
            <p>
              {matchingSchool ? (
                <a href={`/schools/${matchingSchool.slug}`}>{guide.school}</a>
              ) : (
                guide.school
              )}
            </p>
            {thinkerConcepts.length > 0 && (
              <p>
                Key terms:{" "}
                {thinkerConcepts.map((concept, index) => (
                  <>
                    {index > 0 && ", "}
                    <a href={conceptPath(concept)}>{concept.term}</a>
                  </>
                ))}
              </p>
            )}
          </aside>
          <article class="prose">
            <h2>{asText ? "About this text" : `Who was ${thinker.name}?`}</h2>
            <p>{guide.overview}</p>
            <h2>Major ideas</h2>
            <p>{guide.ideas}</p>
            <h2>Major works</h2>
            <ul>
              {guide.works.map((work) => {
                const workPage = worksByThinker.find((entry) => entry.work.title === work);
                return (
                  <li>
                    {workPage ? <a href={workPage.path}>{work}</a> : work}
                  </li>
                );
              })}
            </ul>
            {worksByThinker.length > 0 && (
              <p>
                <a href="/works">Every work in this archive →</a>
              </p>
            )}
            <h2>Legacy</h2>
            <p>{guide.legacy}</p>
            {
              topThemes.length > 0 && (
                <>
                  <h2>Themes in this archive</h2>
                  <p>
                    {topThemes.map(([theme, count], index) => (
                      <>
                        {index > 0 && " · "}
                        <a href={themePath(theme)}>
                          {theme} ({count})
                        </a>
                      </>
                    ))}
                  </p>
                </>
              )
            }
            {
              indexedPairs.length > 0 && (
                <>
                  <h2>Quotes by theme</h2>
                  <p>
                    {indexedPairs.map((pair, index) => (
                      <>
                        {index > 0 && " · "}
                        <a href={`/thinkers/${pair.authorSlug}/${pair.themeSlug}`}>
                          {pair.author} on {pair.theme.toLowerCase()}
                        </a>
                      </>
                    ))}
                  </p>
                </>
              )
            }
          </article>
        </div>
      )
    }

    <ol class="quote-list">
      {
        thinker.quotes.map((quote) => (
          <li class="quote-list-item">
            <blockquote>{quote.text}</blockquote>
            <footer>
              {/* Excerpt anchors instead of bare archive IDs: a thinker hub is
                  the top internal linker for its own quotation pages, so the
                  anchor should carry the destination page's own words. */}
              <a href={`/quotes/${quote.id.toLowerCase()}`}>
                “{truncateWords(quote.text, 8)}” — source & context
              </a>
              <br />
              {canonicalizeTheme(quote.themes[0] ?? quote.school)}
            </footer>
          </li>
        ))
      }
    </ol>

    {essay && <HubEssay essay={essay} />}

    {
      showLanguageSection && (
        <section class="related-block" aria-labelledby="language-title">
          <div class="section-intro">
            <p class="section-label">Original language &amp; citation</p>
            <h2 id="language-title">Reading and citing {thinker.name} responsibly</h2>
          </div>
          <dl class="source-record">
            {originalLanguages.length > 0 && (
              <div>
                <dt>Original languages on record</dt>
                <dd>{originalLanguages.join(", ")}</dd>
              </div>
            )}
            {sourcing?.language && (
              <div>
                <dt>Language of the works</dt>
                <dd>{sourcing.language}</dd>
              </div>
            )}
            {sourcing?.citation && (
              <div>
                <dt>How to cite</dt>
                <dd>{sourcing.citation}</dd>
              </div>
            )}
          </dl>
          {thinkerHasSourcePage && (
            <p class="related-link">
              <a href={thinkerSourcePath(thinker.name)}>
                Full sourcing profile: which edition, which citation system, what goes wrong
              </a>
            </p>
          )}
        </section>
      )
    }

    {
      relatedThinkers.length > 0 && (
        <section class="related-block" aria-labelledby="related-title">
          <div class="section-intro">
            <p class="section-label">Nearby in the tradition</p>
            <h2 id="related-title">Thinkers read alongside {thinker.name}</h2>
          </div>
          <p class="hero-value" style="margin-top:0">
            {
              relatedThinkers.map((other, index) => (
                <>
                  {index > 0 && " · "}
                  <a href={`/thinkers/${other.slug}`}>{other.name}</a>
                </>
              ))
            }
          </p>
        </section>
      )
    }

    <section class="related-block" aria-labelledby="references-title">
      <div class="section-intro">
        <p class="section-label">Sources &amp; further reading</p>
        <h2 id="references-title">Checking this page against scholarship</h2>
      </div>
      <ul class="link-list">
        {references.sep && (
          <li>
            <a href={references.sep} rel="noopener">
              Stanford Encyclopedia of Philosophy: {thinker.name}
            </a>
          </li>
        )}
        {references.iep && (
          <li>
            <a href={references.iep} rel="noopener">
              Internet Encyclopedia of Philosophy: {thinker.name}
            </a>
          </li>
        )}
        <li>
          <a href="/sourcing-method">How this archive sources and checks its texts</a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
