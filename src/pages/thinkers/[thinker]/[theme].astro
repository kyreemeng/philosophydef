---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  thinkerThemePairs,
  themeGroups,
  truncateWords,
} from "../../../lib/content";
import { thinkerGuideFor, themeGuideFor, defaultThemeGuide } from "../../../data/enrichment";
import {
  shouldIndexTheme,
  shouldIndexThinkerThemePair,
} from "../../../lib/indexing";
import { pageSeoOverrides } from "../../../data/seo-overrides";

export function getStaticPaths() {
  // Preserve GSC-proven long-tail URLs even when later corpus normalization
  // leaves fewer than four quotations in the pair.
  return thinkerThemePairs(1)
    .filter(shouldIndexThinkerThemePair)
    .map((pair) => ({
    params: { thinker: pair.authorSlug, theme: pair.themeSlug },
    props: { pair },
    }));
}

const { pair } = Astro.props;
const pageUrl = `/thinkers/${pair.authorSlug}/${pair.themeSlug}`;
const relatedThemes = themeGroups()
  .filter(
    (theme) =>
      theme.slug !== pair.themeSlug &&
      shouldIndexTheme(theme),
  )
  .slice(0, 6);
const thinkerGuide = thinkerGuideFor(pair.author);
const themeGuide =
  themeGuideFor(pair.theme) ?? defaultThemeGuide(pair.theme, pair.quotes.length);
const seo = pageSeoOverrides[pageUrl] ?? {};

const viewpoint = thinkerGuide
  ? `${pair.author} (${thinkerGuide.lifespan}) approaches ${pair.theme.toLowerCase()} within ${thinkerGuide.school}. ${thinkerGuide.ideas.split(/(?<=\.)\s+/).slice(0, 2).join(" ")} On this page, the archive isolates English passages where that project meets ${pair.theme.toLowerCase()} most directly—useful for searches such as “${pair.author.toLowerCase()} quotes on ${pair.theme.toLowerCase()}.”`
  : `${pair.author} appears in this archive through verified English quotations that touch ${pair.theme.toLowerCase()}. ${themeGuide.overview} Read the passages as entry points, then return to the full thinker and theme pages for wider context.`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${pair.author} Quotes on ${pair.theme}`,
    description: `English philosophy quotations by ${pair.author} on ${pair.theme.toLowerCase()}.`,
    url: new URL(pageUrl, Astro.site),
    numberOfItems: pair.quotes.length,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Thinkers",
        item: new URL("/thinkers", Astro.site),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: pair.author,
        item: new URL(`/thinkers/${pair.authorSlug}`, Astro.site),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: pair.theme,
        item: new URL(pageUrl, Astro.site),
      },
    ],
  },
];
---

<BaseLayout
  title={seo.title ??
    `${pair.author} Quotes on ${pair.theme} | Philosophy Blind Box`}
  description={seo.description ??
    `Read ${pair.quotes.length} English ${pair.author} quotes on ${pair.theme.toLowerCase()}. Verified renderings with source context and related themes.`}
  canonical={pageUrl}
  schema={schema}
>
  <div class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">Thinker × theme</p>
      <h1>{pair.author} quotes on {pair.theme.toLowerCase()}</h1>
      <p>
        {pair.quotes.length} verified English passages where {pair.author}’
        {pair.author.endsWith("s") ? "" : "s"} thought meets questions of{" "}
        {pair.theme.toLowerCase()}.
      </p>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/thinkers">Thinkers</a>
        <span aria-hidden="true">/</span>
        <a href={`/thinkers/${pair.authorSlug}`}>{pair.author}</a>
        <span aria-hidden="true">/</span>
        <span>{pair.theme}</span>
      </nav>
    </header>

    <div class="prose-layout">
      <aside class="prose-aside">
        <p>
          Long-tail reading path: one thinker, one theme, several angles—without
          diluting either page into a slogan list.
        </p>
      </aside>
      <article class="prose">
        <h2>{pair.author} on {pair.theme.toLowerCase()}</h2>
        <p>{viewpoint}</p>
        <h2>How to use this page</h2>
        <p>
          Start with the shortest passage, then compare tone across sources. Return to
          the <a href={`/thinkers/${pair.authorSlug}`}>{pair.author} thinker page</a>{" "}
          for biography and to the{" "}
          <a href={`/themes/${pair.themeSlug}`}>{pair.theme.toLowerCase()} theme</a>{" "}
          for other voices on the same question.
        </p>
        <h2>Frequently asked</h2>
        <h3>What did {pair.author} say about {pair.theme.toLowerCase()}?</h3>
        <p>
          The quotations below are the archive’s curated answer: English renderings
          selected for clarity and attribution, not a complete corpus.
        </p>
        <h3>
          Where else should I read after {pair.author.toLowerCase()} on{" "}
          {pair.theme.toLowerCase()}?
        </h3>
        <p>
          Related themes:{" "}
          {
            relatedThemes.map((theme, index) => (
              <>
                {index > 0 && ", "}
                <a href={`/themes/${theme.slug}`}>{theme.name}</a>
              </>
            ))
          }
          .
        </p>
      </article>
    </div>

    <ol class="quote-list">
      {
        pair.quotes.map((quote) => (
          <li class="quote-list-item">
            <blockquote>{quote.text}</blockquote>
            <footer>
              {/* Excerpt anchors instead of bare archive IDs, so each passage
                  page is linked by its own words. */}
              <a href={`/quotes/${quote.id.toLowerCase()}`}>
                “{truncateWords(quote.text, 8)}” — source & context
              </a>
              <br />
              {quote.source || quote.school}
            </footer>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
