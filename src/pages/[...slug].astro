---
import BaseLayout from "../layouts/BaseLayout.astro";
import quotes from "../data/quotes.json";
import { guides } from "../data/guides";
import { pageSeoOverrides } from "../data/seo-overrides";

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const pageUrl = `/${guide.slug}`;
const featuredQuotes = quotes
  .filter((quote) => guide.thinkers.includes(quote.author))
  .slice(0, 3);
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: guide.title,
    description: guide.description,
    mainEntityOfPage: new URL(pageUrl, Astro.site),
    inLanguage: "en",
    ...(guide.updated ? { dateModified: guide.updated } : {}),
    author: {
      "@type": "Organization",
      name: "Philosophy Defined",
      url: new URL("/about", Astro.site),
    },
    publisher: {
      "@type": "Organization",
      name: "Philosophy Defined",
      url: Astro.site,
    },
    ...(guide.furtherReading ? { citation: guide.furtherReading } : {}),
  },
  // The guide renders its FAQ as visible Q&A, so the structured data has to
  // match that text exactly. It was missing here while the markup existed,
  // which left the questions eligible for neither a rich result nor an answer.
  ...(guide.faq?.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: guide.faq.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: item.answer,
            },
          })),
        },
      ]
    : []),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL("/", Astro.site),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: guide.title,
        item: new URL(pageUrl, Astro.site),
      },
    ],
  },
];
const seo = pageSeoOverrides[pageUrl] ?? {};
const pageTitle = seo.title ?? `${guide.title} | Philosophy Defined`;
const pageDescription = seo.description ?? guide.description;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  type="article"
  schema={schema}
>
  <article class="page-shell guide">
    <header class="page-intro guide-intro">
      <p class="eyebrow">{guide.eyebrow}</p>
      <h1>{guide.title}</h1>
      <p>{guide.intro}</p>
      {guide.updated && (
        <p class="guide-byline">
          Philosophy Defined · Last reviewed{" "}
          <time datetime={guide.updated}>{guide.updated}</time> ·{" "}
          <a href="/editorial-policy">How guides are written</a>
        </p>
      )}
    </header>

    <div class="guide-layout">
      <aside class="guide-aside" aria-label="On this page">
        <p>On this page</p>
        <ol>
          {
            guide.sections.map((section, index) => (
              <li><a href={`#section-${index + 1}`}>{section.heading}</a></li>
            ))
          }
          {guide.comparison && <li><a href="#comparison">Side by side</a></li>}
          {guide.faq && <li><a href="#faq">FAQ</a></li>}
          {guide.furtherReading && <li><a href="#further-reading">Further reading</a></li>}
        </ol>
      </aside>

      <div class="guide-content">
        <section class="guide-answer" aria-label="Short answer">
          <h2>Short answer</h2>
          <p>{guide.answer}</p>
        </section>

        {
          guide.comparison && (
            <section id="comparison" aria-labelledby="comparison-title">
              <h2 id="comparison-title">Side by side</h2>
              <table>
                <thead>
                  <tr>
                    <th scope="col">Aspect</th>
                    <th scope="col">{guide.title.split(" vs ")[0]}</th>
                    <th scope="col">{guide.title.split(" vs ")[1]?.replace(/[:?].*$/, "")}</th>
                  </tr>
                </thead>
                <tbody>
                  {guide.comparison.map((row) => (
                    <tr>
                      <th scope="row">{row.aspect}</th>
                      <td>{row.left}</td>
                      <td>{row.right}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          )
        }

        {
          guide.sections.map((section, index) => (
            <section id={`section-${index + 1}`}>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </section>
          ))
        }

        {
          guide.faq && (
            <section id="faq" aria-labelledby="faq-title">
              <h2 id="faq-title">Frequently asked questions</h2>
              {guide.faq.map((item) => (
                <>
                  <h3>{item.question}</h3>
                  <p>{item.answer}</p>
                </>
              ))}
            </section>
          )
        }

        {
          guide.furtherReading && (
            <section id="further-reading" aria-labelledby="further-reading-title">
              <h2 id="further-reading-title">Further reading</h2>
              <ul>
                {guide.furtherReading.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          )
        }

        {
          featuredQuotes.length > 0 && (
            <section class="guide-quotes" aria-labelledby="related-quotations">
              <p class="eyebrow">From the archive</p>
              <h2 id="related-quotations">Read alongside this guide</h2>
              <div>
                {featuredQuotes.map((quote) => (
                  <blockquote>
                    <p>“{quote.text}”</p>
                    <footer>
                      <a href={`/quotes/${quote.id.toLowerCase()}`}>
                        {quote.author}, {quote.source}
                      </a>
                    </footer>
                  </blockquote>
                ))}
              </div>
            </section>
          )
        }

        <nav class="guide-related" aria-label="Related guides">
          <p class="eyebrow">Continue exploring</p>
          <ul>
            {guide.related.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>
