---
import ThinkerSourcePage from "../../components/source/ThinkerSourcePage.astro";
import quotes from "../../data/quotes.json";
import {
  assertNoSourceSlugCollision,
  MIN_QUOTES_FOR_SOURCE_PAGE,
  thinkerSourcing,
} from "../../data/thinker-sourcing";
import { slugify } from "../../lib/content";

/**
 * Per-thinker sourcing profiles: which edition, which citation system, and
 * what goes wrong when this author is quoted.
 *
 * Per-passage source records used to share this route. They duplicated the
 * verification material already on each quotation page, so the quotation page
 * is now the only home for a passage and the old URLs redirect to it (see
 * scripts/generate-vercel-redirects.mjs).
 */
export function getStaticPaths() {
  const byAuthor = new Map<string, (typeof quotes)[number][]>();
  for (const quote of quotes) {
    byAuthor.set(quote.author, [...(byAuthor.get(quote.author) ?? []), quote]);
  }

  const thinkers = [...byAuthor.entries()]
    .filter(
      ([author, items]) =>
        items.length >= MIN_QUOTES_FOR_SOURCE_PAGE && thinkerSourcing[author],
    )
    .map(([author, items]) => ({
      params: { slug: slugify(author) },
      props: { author, items },
    }));

  assertNoSourceSlugCollision(thinkers.map((entry) => `/quote-source/${entry.params.slug}`));

  return thinkers;
}

const { author, items } = Astro.props;
---

<ThinkerSourcePage author={author} items={items} />
