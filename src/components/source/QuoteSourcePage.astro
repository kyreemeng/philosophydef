---
import BaseLayout from "../../layouts/BaseLayout.astro";
import quotes from "../../data/quotes.json";
import type { Quote } from "../../lib/content";
import {
  quoteSourceHeading,
  quoteSourcePath,
  quoteSourceTitle,
  slugify,
  thinkerSourcePath,
  truncateWords,
} from "../../lib/content";
import { buildCitations } from "../../lib/citation";
import { quoteVerification } from "../../data/quote-verification";
import { hasThinkerSourcePage, thinkerSourcing } from "../../data/thinker-sourcing";

interface Props {
  quote: Quote;
}

const { quote } = Astro.props;
const note = quoteVerification[quote.id.toUpperCase()];
const pageUrl = quoteSourcePath(quote);
const quoteUrl = `/quotes/${quote.id.toLowerCase()}`;
// Sourcing pages are written only for passages that carry a verification
// record, so the access date is the record's own date rather than a fallback.
const citations = buildCitations({
  author: quote.author,
  text: quote.text,
  source: quote.source,
  url: quoteUrl,
  accessDate: note?.lastVerified ?? "2026-09-14",
});
const sourceLanguage = thinkerSourcing[quote.author]?.language ?? "non-English";
const sameAuthor = quotes
  .filter((item) => item.author === quote.author && item.id !== quote.id)
  .slice(0, 2);
/**
 * Where the author trail should point.
 *
 * An author's own source page exists only once they clear the threshold, and an
 * earlier version of this record linked it regardless — for the nine authors
 * below the threshold that was a link to nothing. Below the threshold the
 * thinker guide is the honest destination, and it is worth linking either way.
 */
const thinkerHasSourcePage = hasThinkerSourcePage(
  quote.author,
  quotes.filter((item) => item.author === quote.author).length,
);
const authorTrailPath = thinkerHasSourcePage
  ? thinkerSourcePath(quote.author)
  : `/thinkers/${slugify(quote.author)}`;

const faq = [
  {
    question: `Who said “${quote.text}”?`,
    answer: `The passage is attributed to ${quote.author}, in ${quote.source}. ${
      note?.attribution ?? ""
    }`.trim(),
  },
  ...(note?.variants?.length
    ? [
        {
          question: `What is the exact wording of the quotation from ${quote.author}?`,
          answer: `The wording recorded here is: “${quote.text}”${
            note.original
              ? ` The ${note.original.language} reads: ${note.original.text}${
                  note.original.note ? ` ${note.original.note}` : ""
                }`
              : ""
          } Forms in circulation that differ from this wording: ${note.variants.join(" / ")}`,
        },
      ]
    : []),
  ...(note
    ? [
        {
          question: `Is this quotation commonly misattributed?`,
          answer: `${note.attribution} Reviewed against the cited source on ${note.lastVerified}.`,
        },
      ]
    : []),
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quotation",
    text: quote.text,
    inLanguage: "en",
    creator: { "@type": "Person", name: quote.author },
    citation: quote.source,
    about: quote.themes[0] ?? quote.school,
    keywords: [quote.author, quote.school, ...quote.themes],
    isPartOf: {
      "@type": "CreativeWork",
      name: "Verified quotation sources",
      url: new URL("/quote-source", Astro.site),
    },
    mainEntityOfPage: new URL(pageUrl, Astro.site),
    url: new URL(pageUrl, Astro.site),
    ...(note?.lastVerified ? { dateModified: note.lastVerified } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((entry) => ({
      "@type": "Question",
      name: entry.question,
      acceptedAnswer: { "@type": "Answer", text: entry.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site) },
      {
        "@type": "ListItem",
        position: 2,
        name: "Quote source",
        item: new URL("/quote-source", Astro.site),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: quote.author,
        item: new URL(authorTrailPath, Astro.site),
      },
      {
        "@type": "ListItem",
        position: 4,
        name: truncateWords(quote.text, 6),
        item: new URL(pageUrl, Astro.site),
      },
    ],
  },
];

const title = quoteSourceTitle(quote);
const description = (
  note
    ? `Who said “${truncateWords(quote.text, 12)}”? Attributed to ${quote.author}, ${quote.source}. Original wording, circulating variants, and the attribution problems recorded.`
    : `Who said “${truncateWords(quote.text, 12)}”? Attributed to ${quote.author}, ${quote.source}. Citation, context, and how to check it.`
).slice(0, 158);
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  type="article"
  schema={schema}
>
  <article class="page-shell source-page">
    <header class="page-intro">
      <p class="eyebrow">Quote source · {quote.id}</p>
      <h1>{quoteSourceHeading(quote)}</h1>
      <p>
        The located source for this passage, the original-language wording where
        one exists, and the forms of it that circulate without the attribution.
      </p>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/quote-source">Quote source</a>
        <span aria-hidden="true">/</span>
        <a href={authorTrailPath}>{quote.author}</a>
        <span aria-hidden="true">/</span>
        <span>{truncateWords(quote.text, 5)}</span>
      </nav>
    </header>

    <section class="quote-stage" aria-labelledby="passage-title">
      <div class="quote-panel">
        <p class="quote-index">English</p>
        <div>
          <blockquote class="quote-text" id="passage-title">
            {quote.text}
          </blockquote>
          <div class="quote-meta">
            <div class="meta-item">
              <span>Thinker</span>
              <strong>
                <a href={`/thinkers/${slugify(quote.author)}`}>{quote.author}</a>
              </strong>
            </div>
            <div class="meta-item">
              <span>Work</span>
              <strong>{quote.source}</strong>
            </div>
            <div class="meta-item">
              <span>School</span>
              <strong>{quote.school}</strong>
            </div>
            <div class="meta-item">
              <span>Theme</span>
              <strong>{quote.themes[0] ?? "Philosophy"}</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="quote-depth prose-layout" aria-labelledby="record-title">
      <aside class="prose-aside">
        <p>
          {note
            ? `Checked against the cited edition on ${note.lastVerified}.`
            : "The citation this archive holds for the passage."}
        </p>
      </aside>
      <div class="prose">
        <h2 id="record-title">The recorded source</h2>
        <dl class="source-profile">
          <dt>Attributed to</dt>
          <dd>{quote.author}</dd>
          <dt>Work and locator</dt>
          <dd>{quote.source}</dd>
          <dt>English wording</dt>
          <dd>“{quote.text}”</dd>
          {note?.original && (
            <>
              <dt>Original wording ({note.original.language})</dt>
              <dd lang="und">{note.original.text}</dd>
            </>
          )}
        </dl>
        {note?.original?.note && <p>{note.original.note}</p>}

        <h2>Exact wording and the variants in circulation</h2>
        <p>
          A quotation in English from a {sourceLanguage} source has two versions,
          and they are not interchangeable.
        </p>
        {
          note?.variants?.length ? (
            <>
              <p>
                The wording recorded here is the one this archive holds. These
                are the forms that circulate in its place:
              </p>
              <ul>
                {note.variants.map((variant) => (
                  <li>“{variant}”</li>
                ))}
              </ul>
            </>
          ) : (
            <p>
              No divergent wording is recorded for this passage: the English in
              circulation matches the wording cited above.
            </p>
          )
        }

        <h2>Attribution notes</h2>
        <p>
          {note?.attribution ??
            `This passage is attributed to ${quote.author} and filed under ${quote.school}. This archive records the English wording in circulation and names the tradition it belongs to rather than inventing a precise locator it cannot support.`}
        </p>

        <h2>How to cite this quotation</h2>
        <p>
          <strong>Primary text:</strong> {citations.primary}
        </p>
        <p>
          <strong>APA 7:</strong> {citations.apa}
        </p>
        <p>
          <strong>MLA 9:</strong> {citations.mla}
        </p>
        <p>
          <strong>Chicago 17:</strong> {citations.chicago}
        </p>
        {note?.lastVerified && (
          <p>
            <strong>Last verified:</strong> {note.lastVerified}
          </p>
        )}
      </div>
    </section>

    <section class="quote-depth prose-layout" aria-labelledby="faq-title">
      <aside class="prose-aside">
        <p>The questions this passage is searched with.</p>
      </aside>
      <div class="prose">
        <h2 id="faq-title">Frequently asked questions</h2>
        {
          faq.map((entry) => (
            <div class="faq-item">
              <h3>{entry.question}</h3>
              <p>{entry.answer}</p>
            </div>
          ))
        }
      </div>
    </section>

    {
      sameAuthor.length > 0 && (
        <section class="related-block" aria-labelledby="same-author-title">
          <div class="section-intro">
            <p class="section-label">Same thinker</p>
            <h2 id="same-author-title">More from {quote.author}</h2>
          </div>
          <ol class="quote-list compact-list">
            {sameAuthor.map((item) => (
              <li class="quote-list-item">
                <blockquote>{item.text}</blockquote>
                <footer>
                  {quoteVerification[item.id.toUpperCase()] ? (
                    <a href={quoteSourcePath(item)}>
                      “{truncateWords(item.text, 8)}” — source record
                    </a>
                  ) : (
                    <a href={`/quotes/${item.id.toLowerCase()}`}>
                      “{truncateWords(item.text, 8)}” — citation
                    </a>
                  )}
                  <br />
                  {item.source}
                </footer>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="related-block" aria-labelledby="next-title">
      <div class="section-intro">
        <p class="section-label">Keep going</p>
        <h2 id="next-title">Where to look next</h2>
      </div>
      <p class="hero-value" style="margin-top:0">
        <a href={quoteUrl}>Read this passage in context</a>
        {
          thinkerHasSourcePage && (
            <>
              {" · "}
              <a href={authorTrailPath}>
                All {quote.author} source records
              </a>
            </>
          )
        }
        {" · "}
        <a href="/quote-source">How to trace any quotation</a>
        {" · "}
        <a href="/quotes">The full archive</a>
      </p>
    </section>
  </article>
</BaseLayout>
