---
import Analytics from "@vercel/analytics/astro";
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/newsreader";
import "../styles/global.css";
import { organizationSchema, websiteSchema } from "../lib/site-schema";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  schema?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = "/og-default.png",
  type = "website",
  schema,
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
} = Astro.props;
const siteName = "Philosophy Blind Box";
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const canonicalUrl = new URL(canonical, Astro.site);
const imageUrl = new URL(image, Astro.site);

/**
 * Navigation, grouped by what the reader is trying to do.
 *
 * The bar used to be seven equally weighted links in a single row, which
 * presented a browse surface, a lookup tool, and a set of long-form guides as
 * though they were the same kind of thing. Three groups say otherwise:
 * "Read" is the archive, "Trace" is the one tool this site is built around,
 * "Learn" is the guides. Google's own documentation is the argument for keeping
 * the sourcing entry in the primary bar rather than the footer — a hub nothing
 * links to cannot rank, and this nav is on every page — so it stays, but as the
 * single item in its own group rather than as the fourth of seven.
 */
const navGroups = [
  {
    label: "Read",
    items: [
      { href: "/quotes", label: "Quotes", match: "/quotes" },
      { href: "/thinkers", label: "Thinkers", match: "/thinkers" },
      { href: "/works", label: "Works", match: "/works" },
      { href: "/themes", label: "Themes", match: "/themes" },
      { href: "/schools", label: "Schools", match: "/schools" },
    ],
  },
  {
    label: "Trace",
    items: [
      { href: "/quote-source", label: "Quote source", match: "/quote-source" },
    ],
  },
  {
    label: "Learn",
    items: [
      { href: "/what-is-philosophy", label: "Guides", match: "/what-is-philosophy" },
      { href: "/branches", label: "Branches", match: "/branches" },
      { href: "/reference", label: "Reference", match: "/reference" },
      { href: "/glossary", label: "Glossary", match: "/glossary" },
      { href: "/about", label: "About", match: "/about" },
    ],
  },
];
const allNavItems = navGroups.flatMap((group) => group.items);
const isCurrent = (match: string) =>
  path === match || path.startsWith(`${match}/`);
const defaultSchema = [
  websiteSchema(Astro.site),
  organizationSchema(Astro.site),
];

/**
 * Pages that pass their own `schema` used to replace this default entirely,
 * which meant the site-wide E-E-A-T markup reached only the handful of pages
 * that passed nothing. Merging instead of overriding puts the WebSite and
 * Organization entities on every URL while still emitting whatever the page
 * needs to describe itself.
 *
 * A page may legitimately describe the same entity with more specific detail,
 * so a page-level node wins over the default of the same @type rather than
 * being emitted twice.
 */
const pageSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const pageSchemaTypes = new Set(pageSchema.map((node) => node?.["@type"]));
const allSchema = [
  ...defaultSchema.filter((node) => !pageSchemaTypes.has(node["@type"])),
  ...pageSchema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192x192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f2e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1715" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {/* Both of these must run before first paint. The reading preference is
        applied to <html> as an attribute so the stored type size and colour
        scheme are in place when the first stylesheet is matched — setting them
        from a deferred script would show the default and then snap to the
        reader's own choice on every navigation, which is worse than not
        offering the control. */}
    <script is:inline>
      (() => {
        try {
          const size = localStorage.getItem("pbb:reading-size");
          const theme = localStorage.getItem("pbb:theme");
          if (size) document.documentElement.dataset.readingSize = size;
          if (theme) document.documentElement.dataset.theme = theme;
        } catch {
          /* Storage can be blocked; the defaults are then the whole story. */
        }
        document.documentElement.classList.add("js");
      })();
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(allSchema)}
    />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="Philosophy Blind Box, home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>
            Philosophy Blind Box
            <small>English philosophy quotations</small>
          </span>
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="nav-links"
        >
          Menu
        </button>
        {/*
          The nav panel, not the link list, is what collapses.

          The search entry and the reading controls used to sit outside the
          collapsible element, so at mobile widths they competed with the brand
          and the menu button for a 375px bar. Everything that is not the brand
          or the toggle now lives inside one panel: a row on desktop, the
          drop-down itself below 1080px.

          The toggle used to appear at 700px while the grouped links hid at
          980px, which left 701–980px with no navigation and no way to open any.
          The two breakpoints are one number now.
        */}
        <div class="nav-panel" id="nav-links">
          <ul class="nav-groups">
            {
              navGroups.map((group) => (
                <li>
                  <ul class="nav-group" aria-label={group.label}>
                    <li aria-hidden="true">{group.label}</li>
                    <li>
                      <ul class="nav-group-links">
                        {group.items.map((item) => (
                          <li>
                            <a
                              href={item.href}
                              aria-current={isCurrent(item.match) ? "page" : undefined}
                            >
                              {item.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  </ul>
                </li>
              ))
            }
          </ul>
          <div class="nav-actions">
            {/* There was no way to search the site from any page except /quotes,
                and the /quotes search only filtered an already-loaded list. This
                entry puts the archive's own index one keystroke away from every
                page. The visible label is one word because the pill shares a
                single row with eight links; the full phrase stays the accessible
                name. */}
            <a class="nav-search" href="/quotes" aria-label="Search the archive">
              Search
            </a>
            {/*
              The reading preferences used to sit open in the bar. Between them
              the two selects and their labels cost the row about 240px, which
              is what pushed the grouped navigation and the search entry past
              the right edge of a 1080px window — the labels wrapped rather than
              the row admitting it had run out of room.

              They are a preference, not a destination, so they live behind one
              labelled control now: still discoverable from every page, but not
              competing with navigation for width. `<details>` does it without
              JavaScript and keeps it keyboard-operable.
            */}
            <details class="prefs">
              <summary>Text &amp; colour</summary>
              <div class="prefs-panel">
                <div class="reading-controls">
                  <label for="reading-size">Text size</label>
                  <select id="reading-size" data-reading-size>
                    <option value="compact">Small</option>
                    <option value="default" selected>Default</option>
                    <option value="large">Large</option>
                    <option value="x-large">Largest</option>
                  </select>
                </div>
                <div class="reading-controls">
                  <label for="reading-theme">Colour scheme</label>
                  <select id="reading-theme" data-reading-theme>
                    <option value="system" selected>System</option>
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                  </select>
                </div>
              </div>
            </details>
          </div>
        </div>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>Philosophy Blind Box</span>
          </a>
          <p>
            A curated archive of English philosophy quotations, each with the
            work and passage it comes from.
          </p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/what-is-philosophy">Philosophy guides</a>
          <a href="/branches">Branches of philosophy</a>
          <a href="/reference">Philosophy reference</a>
          <a href="/glossary">Glossary of terms</a>
          <a href="/quotes">Browse the archive</a>
          <a href="/works">Quotes by work</a>
          <a href="/misattributed-quotes">Misattributed quotes</a>
          <a href="/quote-source">Who said this quote?</a>
          <a href="/random-philosophy-generator">Random quote generator</a>
          <a href="/quotes/famous">Famous quotes</a>
          <a href="/schools/stoicism">Stoicism</a>
          <a href="/why-philosophy-matters">Why philosophy matters</a>
          <a href="/editorial-policy">Editorial policy</a>
          <a href="/sourcing-method">Sourcing method</a>
          <a href="/about">About this archive</a>
          <a href="/sitemap-index.xml">Sitemap</a>
        </nav>
      </div>
    </footer>
    <script>
      // The nav announces itself as a menu only when the stylesheet has actually
      // collapsed it; aria-expanded is the state, and data-open is what the
      // mobile layout reads. Both are set here so they cannot drift apart.
      const toggle = document.querySelector(".nav-toggle");
      const panel = document.querySelector("#nav-links");
      const collapse = () => {
        toggle?.setAttribute("aria-expanded", "false");
        panel?.removeAttribute("data-open");
      };
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        if (open) panel?.removeAttribute("data-open");
        else panel?.setAttribute("data-open", "true");
      });
      // A reader who opens the menu and then widens the window would otherwise
      // be left with the panel's state applied to the full-width bar. 1080px is
      // the same boundary the stylesheet collapses at; the two must agree.
      window.matchMedia("(min-width: 1080px)").addEventListener("change", (event) => {
        if (event.matches) collapse();
      });
      // Following a link closes the menu. The reading controls are inside the
      // panel but are not links, so choosing a preference leaves it open.
      panel?.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) collapse();
      });

      // The preferences disclosure is native <details>, which stays open until
      // it is toggled. A floating panel that survives a click elsewhere on the
      // page reads as broken, so outside clicks and Escape close it.
      const prefs = document.querySelector(".prefs");
      if (prefs instanceof HTMLDetailsElement) {
        document.addEventListener("click", (event) => {
          if (!prefs.open) return;
          if (!prefs.contains(event.target as Node)) prefs.open = false;
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && prefs.open) {
            prefs.open = false;
            prefs.querySelector("summary")?.focus();
          }
        });
      }
    </script>
    <script>
      // Reading preferences. Written to <html> as data attributes, mirrored into
      // localStorage so the next page load can apply them before first paint,
      // and read back from the DOM on load so the controls show the state that
      // is actually in force rather than their markup defaults.
      const root = document.documentElement;
      const sizeSelect = document.querySelector<HTMLSelectElement>("[data-reading-size]");
      const themeSelect = document.querySelector<HTMLSelectElement>("[data-reading-theme]");
      const STORE = { size: "pbb:reading-size", theme: "pbb:theme" };

      const applyReadingSize = (value: string) => {
        if (value && value !== "default") root.dataset.readingSize = value;
        else delete root.dataset.readingSize;
      };
      const applyTheme = (value: string) => {
        if (value && value !== "system") root.dataset.theme = value;
        else delete root.dataset.theme;
      };

      if (sizeSelect) {
        sizeSelect.value = root.dataset.readingSize ?? "default";
        sizeSelect.addEventListener("change", () => {
          applyReadingSize(sizeSelect.value);
          try {
            localStorage.setItem(STORE.size, sizeSelect.value);
          } catch {
            /* Preference simply does not persist. */
          }
        });
      }
      if (themeSelect) {
        themeSelect.value = root.dataset.theme ?? "system";
        themeSelect.addEventListener("change", () => {
          applyTheme(themeSelect.value);
          try {
            localStorage.setItem(STORE.theme, themeSelect.value);
          } catch {
            /* Preference simply does not persist. */
          }
        });
      }
    </script>
  </body>
</html>
