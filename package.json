{
  "name": "philosophy-blind-box",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A daily philosophy blind box with curated English quotations.",
  "scripts": {
    "build:quotes": "node scripts/build-quotes.mjs",
    "build:og": "node scripts/build-og.mjs",
    "build:data": "node scripts/export-quote-data.mjs",
    "build:sitemaps": "node scripts/build-sitemaps.mjs",
    "generate:redirects": "node scripts/generate-vercel-redirects.mjs",
    "seo:verify": "node scripts/seo-verify.mjs",
    "seo:indexability": "node scripts/indexability-audit.mjs",
    "seo:links": "node scripts/link-audit.mjs",
    "seo:tabapi": "node scripts/tabapi-stats.mjs",
    "validate:corpus": "node scripts/validate-corpus.mjs",
    "dev": "npm run build:data && astro dev",
    "build": "npm run build:quotes && npm run build:og && npm run build:data && astro build && npm run build:sitemaps && node scripts/create-sitemap-alias.mjs && npm run seo:indexability && npm run seo:links",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.1.3",
    "html-to-image": "^1.11.13",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
